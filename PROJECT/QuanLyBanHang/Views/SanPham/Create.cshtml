@model QuanLyBanHang.Models.SanPham

@{
    ViewBag.Title = "Thêm sản phẩm mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "SanPham")" class="text-success text-decoration-none">Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>

    @using (Html.BeginForm("Create", "SanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Thông tin cơ bản</h5>
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên sản phẩm</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-box text-muted"></i></span>
                            @Html.TextBoxFor(m => m.TenSP, new { @class = "form-control border-0 bg-transparent", placeholder = "Ví dụ: Coca Cola 330ml" })
                        </div>
                        @Html.ValidationMessageFor(m => m.TenSP, "", new { @class = "text-danger small mt-1" })
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Giá bán niêm yết</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-money-bill-wave text-muted"></i></span>
                                @Html.TextBoxFor(m => m.GiaBan, new { @class = "form-control border-0 bg-transparent", type = "number", placeholder = "0" })
                                <span class="input-group-text bg-transparent border-0 text-muted small">₫</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.GiaBan, "", new { @class = "text-danger small mt-1" })
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Loại sản phẩm</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-tags text-muted"></i></span>
                                @Html.DropDownListFor(model => model.MaLoai, (SelectList)ViewBag.LoaiSP, "Chọn loại hàng", new { @class = "form-select border-0 bg-transparent" })
                            </div>
                            @Html.ValidationMessageFor(m => m.MaLoai, "", new { @class = "text-danger small mt-1" })
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small text-uppercase fw-bold text-muted">Trạng thái kinh doanh</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-flag text-muted"></i></span>
                            @Html.DropDownListFor(m => m.MaTT, (SelectList)ViewBag.MaTT, "Chọn trạng thái", new { @class = "form-select border-0 bg-transparent" })
                        </div>
                        @Html.ValidationMessageFor(m => m.MaTT, "", new { @class = "text-danger small mt-1" })
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="md-card bg-light border-0 mb-4">
                    <h5 class="fw-bold mb-4">Xác nhận lưu</h5>
                    <p class="text-muted small mb-4">Đảm bảo các cấu hình thông tin sản phẩm đã chính xác trước khi thêm vào hệ thống kho hàng.</p>
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-success shadow-sm">
                            <i class="fa-solid fa-circle-check me-2"></i>Lưu sản phẩm
                        </button>
                        <a asp-action="Index" class="btn btn-light border">
                            <i class="fa-solid fa-xmark me-2"></i>Hủy bỏ
                        </a>
                    </div>
                </div>

                <div class="md-card">
                    <h6 class="fw-bold text-muted text-uppercase mb-3 small">Lưu ý nghiệp vụ</h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-2">Tên sản phẩm nên bao gồm thương hiệu và quy cách (ví dụ: Coca Cola 330ml).</li>
                        <li>Giá bán nên là số dương và không bao gồm ký tự phân cách hàng nghìn.</li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>