@model QuanLyBanHang.Models.SanPhamDto

@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "SanPham")" class="text-success text-decoration-none">Sản Phẩm</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "SanPham", new { id = Model.MaSP })" class="text-success text-decoration-none">@Model.MaSP</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaSP" />
        
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Cập nhật thông tin</h5>
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên sản phẩm</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-pen-to-square text-muted"></i></span>
                            <input asp-for="TenSP" class="form-control border-0 bg-transparent" />
                        </div>
                        <span asp-validation-for="TenSP" class="text-danger small mt-1"></span>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Giá bán niêm yết</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-money-bill-wave text-muted"></i></span>
                                <input asp-for="GiaBan" class="form-control border-0 bg-transparent" type="number" step="1" />
                                <span class="input-group-text bg-transparent border-0 text-muted small">₫</span>
                            </div>
                            <span asp-validation-for="GiaBan" class="text-danger small mt-1"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Loại sản phẩm</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-tags text-muted"></i></span>
                                <select asp-for="MaLoai" asp-items="ViewBag.LoaiSP" class="form-select border-0 bg-transparent"></select>
                            </div>
                            <span asp-validation-for="MaLoai" class="text-danger small mt-1"></span>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small text-uppercase fw-bold text-muted">Trạng thái kinh doanh</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-flag text-muted"></i></span>
                            <select asp-for="MaTT" asp-items="ViewBag.MaTT" class="form-select border-0 bg-transparent"></select>
                        </div>
                        <span asp-validation-for="MaTT" class="text-danger small mt-1"></span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="md-card bg-light border-0 mb-4">
                    <h5 class="fw-bold mb-4">Xác nhận thay đổi</h5>
                    <p class="text-muted small mb-4">Việc chỉnh sửa thông tin sẽ được áp dụng ngay lập tức cho các đơn hàng chưa thanh toán.</p>
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-success shadow-sm">
                            <i class="fa-solid fa-cloud-arrow-up me-2"></i>Cập nhật thông tin
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaSP" class="btn btn-light border">
                            <i class="fa-solid fa-xmark me-2"></i>Hủy chỉnh sửa
                        </a>
                    </div>
                </div>

                <div class="md-card">
                    <h6 class="fw-bold text-muted text-uppercase mb-3 small">Thông tin hệ thống</h6>
                    <div class="small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Mã định danh (ID):</span>
                            <span class="font-monospace fw-bold">@Model.MaSP</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Tồn kho hiện tại:</span>
                            <span class="badged @(Model.SoLuongTon > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">@Model.SoLuongTon</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
