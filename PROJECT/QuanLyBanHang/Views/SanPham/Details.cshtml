@model QuanLyBanHang.Models.SanPhamDto

@{
    ViewBag.Title = "Chi tiết Sản phẩm";
    bool isCustomer = ViewBag.IsCustomer == true;
}

<div class="container">
    <!-- Breadcrumb or Back navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "SanPham")" class="text-success text-decoration-none">Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.MaSP</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Left Column: Primary Information -->
        <div class="col-lg-8">
            <div class="md-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <span class="badged bg-success-subtle text-success mb-2">@Model.TenLoai</span>
                        <h2 class="fw-bold mb-1">@Model.TenSP</h2>
                        <div class="text-muted font-monospace">@Model.MaSP</div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small text-uppercase fw-bold mb-1">Giá bán hiện tại</div>
                        <div class="h2 fw-bold text-success mb-0">@string.Format("{0:N0}", Model.GiaBan) <small class="fs-6">₫</small></div>
                    </div>
                </div>

                <hr class="opacity-10 my-4">

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <div class="small text-muted text-uppercase fw-bold mb-2"><i class="fa-solid fa-warehouse me-2"></i>Tình trạng kho</div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="h4 mb-0 fw-bold">@Model.SoLuongTon</div>
                                <span class="badged @(Model.SoLuongTon > 0 ? "bg-success" : "bg-danger")">
                                    @(Model.SoLuongTon > 0 ? "Còn hàng" : "Hết hàng")
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <div class="small text-muted text-uppercase fw-bold mb-2"><i class="fa-solid fa-tag me-2"></i>Trạng thái kinh doanh</div>
                            <div class="h5 mb-0 fw-bold">@(Model.TenTT ?? Model.MaTT)</div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold mb-3">Mô tả chi tiết</h5>
                    <p class="text-secondary lh-lg">
                        Sản phẩm thuộc nhóm <strong>@Model.TenLoai</strong>, được niêm yết với mức giá <strong>@string.Format("{0:N0}", Model.GiaBan) VNĐ</strong>. 
                        Hiện tại trong hệ thống ghi nhận số lượng tồn kho là <strong>@Model.SoLuongTon</strong> đơn vị sản phẩm.
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Column: Actions & Metadata -->
        <div class="col-lg-4">
            <div class="md-card mb-4 bg-light border-0">
                <h5 class="fw-bold mb-4">Thao tác quản lý</h5>
                <div class="d-grid gap-3">
                    @if (!isCustomer)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.MaSP" class="btn btn-success shadow-sm">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa thông tin
                        </a>
                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <a asp-action="Delete" asp-route-id="@Model.MaSP" class="btn btn-outline-danger">
                                <i class="fa-solid fa-trash me-2"></i>Xóa khỏi hệ thống
                            </a>
                        }
                    }
                    <a asp-action="Index" class="btn btn-light border">
                        <i class="fa-solid fa-arrow-left me-2"></i>Quay lại danh sách
                    </a>
                </div>
            </div>

            <div class="md-card">
                <h6 class="fw-bold text-muted text-uppercase mb-3 small">Thông tin hệ thống</h6>
                <div class="small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Ngày ghi nhận:</span>
                        <span class="fw-medium">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">ID định danh:</span>
                        <span class="font-monospace">@Model.MaSP</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
