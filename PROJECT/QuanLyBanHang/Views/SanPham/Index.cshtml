@model IEnumerable<QuanLyBanHang.Models.SanPhamDto>

@{
    ViewBag.Title = "Quản lý Sản phẩm";
    bool isCustomer = ViewBag.IsCustomer == true;
}

<div class="container">
    <!-- Header Action Area -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div></div>
        <div class="d-flex gap-2">
            @if (!isCustomer)
            {
                <a href="@Url.Action("Index", "TrangThai")" class="btn btn-outline-success">
                    <i class="fa-solid fa-list-check me-2"></i>Trạng thái
                </a>
                <a href="@Url.Action("Create", "SanPham")" class="btn btn-success">
                    <i class="fa-solid fa-plus me-2"></i>Thêm sản phẩm
                </a>
            }
        </div>
    </div>

    @if (!isCustomer)
    {
        <!-- Filtering Area -->
        <div class="md-card mb-4">
            <form id="filterForm" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-uppercase fw-bold text-muted">Tìm kiếm</label>
                    <div class="input-group border rounded-3 bg-light">
                        <span class="input-group-text bg-transparent border-0"><i class="fa fa-search text-muted"></i></span>
                        <input type="text" name="search" id="searchBox" class="form-control border-0 bg-transparent" 
                               placeholder="Tên hoặc mã sản phẩm..." value="@ViewBag.Search">
                    </div>
                </div>
                
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-bold text-muted">Trạng thái</label>
                    @Html.DropDownList("maTT", (SelectList)ViewBag.MaTT, "Tất cả trạng thái", new { @class = "form-select border-0 bg-light", id = "maTTSelect" })
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-bold text-muted">Loại hàng</label>
                    @Html.DropDownList("maLoai", (SelectList)ViewBag.LoaiSP, "Tất cả loại", new { @class = "form-select border-0 bg-light", id = "maLoaiSelect" })
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="button" id="btnClear" class="btn btn-light flex-grow-1">
                        <i class="fa-solid fa-rotate-left"></i>
                    </button>
                    <button type="submit" class="btn btn-success flex-grow-1">
                        <i class="fa-solid fa-filter"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Data Table -->
        <div class="table-responsive shadow-sm">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã Sản Phẩm</th>
                        <th>Tên Sản Phẩm</th>
                        <th>Loại Hàng</th>
                        <th class="text-end">Giá Bán</th>
                        <th class="text-center">Số Lượng Tồn</th>
                        <th class="text-center">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "SanPham", new { id = item.MaSP })'">
                                <td class="ps-4"><span class="badged bg-light text-dark font-monospace">@item.MaSP</span></td>
                                <td class="fw-bold">@item.TenSP</td>
                                <td class="text-muted">@item.TenLoai</td>
                                <td class="text-end fw-bold text-success">@string.Format("{0:N0}", item.GiaBan) ₫</td>
                                <td class="text-center">
                                    @{
                                        var stockClass = item.SoLuongTon <= 0 ? "bg-danger" : (item.SoLuongTon < 10 ? "bg-warning text-dark" : "bg-success-subtle text-success");
                                    }
                                    <span class="badged @stockClass">@item.SoLuongTon</span>
                                </td>
                                <td class="text-center">
                                    <span class="text-muted small">@item.TenTT</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-box-open d-block fs-1 mb-3 opacity-25"></i>
                                Không tìm thấy sản phẩm nào phù hợp
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- Customer View: Grid of Cards -->
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="md-card h-100 d-flex flex-column p-0">
                            <div class="p-4 flex-grow-1">
                                <div class="mb-2">
                                    <span class="badged bg-success-subtle text-success small">@product.TenLoai</span>
                                </div>
                                <h5 class="fw-bold mb-3 product-title" style="min-height: 3rem;">@product.TenSP</h5>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="fs-4 fw-bold text-success">@product.GiaBan?.ToString("N0") ₫</div>
                                    <div class="text-muted small">@product.TenTT</div>
                                </div>
                            </div>
                            <div class="p-4 border-top bg-light-subtle rounded-bottom-4">
                                @if (Context.Session.GetString("IsLoggedIn") == "true")
                                {
                                    <a href="@Url.Action("Details", "SanPham", new { id = product.MaSP })" class="btn btn-success w-100">
                                        <i class="fa-solid fa-circle-info me-2"></i>Chi Tiết
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Login", "Home")" class="btn btn-outline-success w-100">
                                        Đăng nhập để xem
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto submit form on select change
            $('#maTTSelect, #maLoaiSelect').on('change', function() {
                $('#filterForm').submit();
            });

            // Clear filter
            $('#btnClear').on('click', function() {
                $('#searchBox').val('');
                $('#maTTSelect').val('');
                $('#maLoaiSelect').val('');
                $('#filterForm').submit();
            });

            // Debounce for search
            let timer;
            $('#searchBox').on('input', function() {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    $('#filterForm').submit();
                }, 500);
            });
        });
    </script>
}
