@model QuanLyBanHang.Models.KhachHang
@{
    ViewBag.Title = "Thêm khách hàng mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "KhachHang")" class="text-success text-decoration-none">Khách Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

        <div class="row g-4">
            <!-- Left: Basic Info -->
            <div class="col-lg-8">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Thông tin cơ bản</h5>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Họ và tên</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-user text-muted"></i></span>
                                <input asp-for="TenKH" class="form-control border-0 bg-transparent" placeholder="Ví dụ: Nguyễn Văn A" />
                            </div>
                            <span asp-validation-for="TenKH" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Giới tính</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-venus-mars text-muted"></i></span>
                                <select asp-for="GioiTinh" class="form-select border-0 bg-transparent">
                                    <option value="">Chọn giới tính</option>
                                    <option value="true">Nam</option>
                                    <option value="false">Nữ</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Số điện thoại</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input asp-for="DienThoaiKH" class="form-control border-0 bg-transparent" placeholder="09xxxxxxx" />
                            </div>
                            <span asp-validation-for="DienThoaiKH" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Email liên hệ</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                                <input asp-for="EmailKH" type="email" class="form-control border-0 bg-transparent" placeholder="example@mail.com" />
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-4 mt-5">Địa chỉ liên lạc</h5>
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Số nhà, tên đường</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-map-location-dot text-muted"></i></span>
                            <input asp-for="DiaChiKH" class="form-control border-0 bg-transparent" placeholder="Số 123, Đường ABC..." />
                        </div>
                        <span asp-validation-for="DiaChiKH" class="text-danger small mt-1"></span>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Tỉnh / Thành phố</label>
                            <select id="MaTinh" name="maTinh" asp-items="@ViewBag.Tinh" class="form-select border rounded-3 bg-light p-3">
                                <option value="">Chọn Tỉnh/Thành</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Xã / Phường</label>
                            <select id="MaXa" asp-for="MaXa" asp-items="@ViewBag.Xa" class="form-select border rounded-3 bg-light p-3">
                                <option value="">Chọn Xã/Phường</option>
                            </select>
                            <span asp-validation-for="MaXa" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Photo & Actions -->
            <div class="col-lg-4">
                <div class="md-card mb-4">
                    <h5 class="fw-bold mb-4">Ảnh đại diện</h5>
                    <div class="text-center mb-4">
                        <div id="imagePreviewContainer" class="avatar-preview-wrapper mb-3">
                            <img id="imagePreview" src="@Url.Content("~/images/default-user.png")" class="rounded-circle border shadow-sm" style="width: 150px; height: 150px; object-fit: cover;">
                        </div>
                        <input type="file" asp-for="AnhFile" id="AnhFile" class="form-control form-control-sm" accept="image/*" onchange="previewImage(this)" />
                    </div>
                </div>

                <div class="md-card bg-light border-0">
                    <h5 class="fw-bold mb-4">Hoàn tất</h5>
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-success py-2 fw-bold">
                            <i class="fa-solid fa-user-plus me-2"></i>Tạo khách hàng
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2">Hủy bỏ</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        $(function () {
            $('#MaTinh').change(function () {
                var maTinh = $(this).val();
                $('#MaXa').html('<option value="">Đang tải...</option>');
                if (maTinh) {
                    $.getJSON('/KhachHang/GetXaByTinh', { maTinh: maTinh }, function (data) {
                        var options = '<option value="">Chọn Xã/Phường</option>';
                        $.each(data, function (i, xa) {
                            options += `<option value="${xa.MaXa}">${xa.TenXa}</option>`;
                        });
                        $('#MaXa').html(options);
                    });
                } else {
                    $('#MaXa').html('<option value="">Chọn Xã/Phường</option>');
                }
            });
        });
    </script>
}
