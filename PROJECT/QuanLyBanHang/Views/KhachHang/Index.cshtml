@model IEnumerable<QuanLyBanHang.Models.KhachHangDetailView>

@{
    ViewBag.Title = "Quản lý Khách hàng";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
           
        </div>
        
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create", "KhachHang")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-user-plus me-2"></i>Thêm khách hàng mới
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="md-card mb-4">
        <form id="filterForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-uppercase fw-bold text-muted">Tìm kiếm thông tin</label>
                <div class="input-group border rounded-3 bg-light">
                    <span class="input-group-text bg-transparent border-0"><i class="fa fa-search text-muted"></i></span>
                    <input type="text" name="search" id="searchBox" class="form-control border-0 bg-transparent" 
                           placeholder="Tên, Email hoặc Số điện thoại..." value="@ViewBag.Search">
                </div>
            </div>
            
            <div class="col-md-3">
                <label class="form-label small text-uppercase fw-bold text-muted">Khu vực (Tỉnh/Thành)</label>
                <select asp-items="ViewBag.TinhList" id="tinhSelect" name="tinh" class="form-select border-0 bg-light">
                    <option value="">Tất cả khu vực</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="button" id="btnClear" class="btn btn-light flex-grow-1 border">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <button type="submit" class="btn btn-success flex-grow-1 shadow-sm">
                    <i class="fa-solid fa-filter me-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Thông Tin Khách Hàng</th>
                    <th>Liên Hệ</th>
                    <th>Địa Chỉ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "KhachHang", new { id = item.MaKH })'">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-wrapper p-1 bg-white shadow-sm rounded-3">
                                        <img src="@(string.IsNullOrEmpty(item.AnhKH) ? Url.Content("~/images/default-user.png") : Url.Content("~/images/customers/" + item.AnhKH))" 
                                             width="48" height="48" class="rounded-2" style="object-fit:cover;">
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.TenKH</div>
                                        <div class="small font-monospace text-muted">ID: @item.MaKH</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small mb-1"><i class="fa-solid fa-phone me-2 text-muted"></i>@item.DienThoaiKH</div>
                                <div class="small"><i class="fa-solid fa-envelope me-2 text-muted"></i>@item.EmailKH</div>
                            </td>
                            <td>
                                <div class="small text-dark fw-medium">@item.DiaChiKH</div>
                                <div class="small text-muted">@item.TenXa, @item.TenTinh</div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-users-slash d-block fs-1 mb-3 opacity-25"></i>
                            Không tìm thấy dữ liệu khách hàng nào
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-submit on change
            $('#tinhSelect').on('change', function() {
                $('#filterForm').submit();
            });

            // Clear filter
            $('#btnClear').on('click', function() {
                $('#searchBox').val('');
                $('#tinhSelect').val('');
                $('#filterForm').submit();
            });

            // Debounce search
            let timer;
            $('#searchBox').on('input', function() {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    $('#filterForm').submit();
                }, 500);
            });
        });
    </script>
}
