@model QuanLyBanHang.Models.KhachHangDetailView

@{
    ViewBag.Title = "Xác nhận xóa khách hàng";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "KhachHang")" class="text-success text-decoration-none">Khách Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="md-card border-0 shadow-lg text-center">
                <div class="p-3 bg-danger-subtle rounded-circle d-inline-block mb-3">
                    <i class="fa-solid fa-user-xmark text-danger fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">Xóa hồ sơ khách hàng?</h4>
                <p class="text-muted">Hành động này sẽ gỡ bỏ thông tin khách hàng khỏi hệ thống quản lý.</p>

                <div class="my-4">
                    <img src="@(string.IsNullOrEmpty(Model.AnhKH) ? Url.Content("~/images/default-user.png") : Url.Content("~/images/customers/" + Model.AnhKH))" 
                         class="rounded-circle shadow-sm border mb-3" style="width: 120px; height: 120px; object-fit: cover;">
                    <div class="h5 fw-bold mb-1">@Model.TenKH</div>
                    <div class="text-muted small font-monospace">ID: @Model.MaKH</div>
                </div>

                <div class="p-3 bg-light rounded-4 mb-4 text-start small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Số điện thoại:</span>
                        <span class="fw-bold">@Model.DienThoaiKH</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Email:</span>
                        <span class="fw-bold">@Model.EmailKH</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Địa chỉ:</span>
                        <span class="fw-bold text-end ms-3">@Model.DiaChiKH, @Model.TenXa, @Model.TenTinh</span>
                    </div>
                </div>

                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaKH" />
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-danger py-3 fw-bold" onclick="confirmDelete()">
                            <i class="fa-solid fa-trash-can me-2"></i>Xác nhận xóa khách hàng
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaKH" class="btn btn-light py-2 border fw-bold text-muted">
                            Hủy bỏ và quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Xóa khách hàng này?',
                text: 'Lịch sử giao dịch liên quan (nếu có) có thể bị ảnh hưởng.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}
