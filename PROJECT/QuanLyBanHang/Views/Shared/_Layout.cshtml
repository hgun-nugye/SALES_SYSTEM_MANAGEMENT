<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyBanHang</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* //icon *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    @* //animation *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    @* //font preconnect *@
    <link rel="preconnect" href="https://fonts.googleapis.com">

    @* //font *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    @* //bootstrap js *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


    <style>
        :root {
            --md-primary: #1b5e20; /* Material Green 900 */
            --md-primary-light: #4c8c4a;
            --md-accent: #ffd600;
            --md-surface: #ffffff;
            --md-background: #f8f9fa;
            --md-text-main: #212121;
            --md-text-muted: #757575;
            --md-shadow: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.24);
            --md-shadow-lg: 0 10px 20px rgba(0,0,0,0.19), 0 6px 6px rgba(0,0,0,0.23);
            --sidebar-width: 280px;
        }

        body {
            display: flex;
            font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
            background-color: var(--md-background);
            color: var(--md-text-main);
            margin: 0;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: #ffffff;
            color: var(--md-primary);
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1000;
            border-right: 1px solid rgba(0,0,0,0.08);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            transition: all 0.3s ease;
        }

        .sidebar-brand {
            padding: 24px;
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--md-primary);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .menu-label {
            padding: 24px 24px 8px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--md-text-muted);
        }

        .sidebar a {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            color: #424242;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.2s;
            margin: 4px 12px;
            border-radius: 12px;
            gap: 12px;
        }

        .sidebar a i {
            font-size: 1.1rem;
            width: 24px;
            text-align: center;
            opacity: 0.7;
        }

        .sidebar a:hover {
            background-color: #f1f8e9;
            color: var(--md-primary);
        }

        .sidebar a.active {
            background-color: var(--md-primary);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(27, 94, 32, 0.25);
        }

        .sidebar a.active i {
            opacity: 1;
        }

        /* Content */
        .content {
            margin-left: var(--sidebar-width);
            flex-grow: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: var(--md-background);
        }

        .top-navbar {
            background: #ffffff;
            padding: 12px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0,0,0,0.08);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .main {
            padding: 32px;
            background-color: transparent;
            box-shadow: none;
            border-radius: 0;
            flex-grow: 1;
        }

        /* Material Components */
        .md-card {
            background: var(--md-surface);
            border-radius: 16px;
            box-shadow: var(--md-shadow);
            border: none;
            padding: 24px;
            margin-bottom: 24px;
            transition: box-shadow 0.3s ease;
        }

        .md-card:hover {
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
        }

        .btn {
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 600;
            text-transform: none;
            letter-spacing: 0.3px;
            transition: all 0.3s;
        }

        .btn-success {
            background-color: var(--md-primary);
            border-color: var(--md-primary);
        }

        .btn-success:hover {
            background-color: #2e7d32;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

        .form-control, .form-select {
            border-radius: 10px;
            padding: 12px 16px;
            border: 1px solid #e0e0e0;
            background-color: #fafafa;
            transition: all 0.2s;
        }

        .form-control:focus, .form-select:focus {
            background-color: #ffffff;
            border-color: var(--md-primary);
            box-shadow: 0 0 0 4px rgba(27, 94, 32, 0.1);
        }

        .table-responsive {
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--md-shadow);
        }

        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #f1f1f1;
            color: var(--md-text-muted);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 16px 24px;
        }

        .table td {
            padding: 16px 24px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
        }

        .badged {
            padding: 6px 12px;
            border-radius: 8px;
            font-weight: 600;
        }

    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <i class="fa-solid fa-store"></i>
            <span>Canteen K8</span>
        </div>
        
        @{
            var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
            bool isCustomer = ViewBag.IsCustomer == true;
        }              

        @if (!isCustomer)
        {           
            <!-- Hàng hóa -->
            <div class="menu-label">Hàng hóa</div>
            <a href="@Url.Action("Index", "SanPham")" class="ajax-link @(ctrl == "SanPham" || ctrl == "TrangThai" ? "active" : "")">
                <i class="fa-solid fa-box"></i>Sản Phẩm
            </a>
            <a href="@Url.Action("Index", "LoaiSP")" class="ajax-link @(ctrl == "LoaiSP" || ctrl == "NhomSP" ? "active" : "")">
                <i class="fa-solid fa-tags"></i>Loại Sản Phẩm
            </a>           

            <!-- Khách hàng & Đối tác -->
            <div class="menu-label">Cung ứng</div>
            <a href="@Url.Action("Index", "KhachHang")" class="ajax-link @(ctrl == "KhachHang" ? "active" : "")">
                <i class="fa-solid fa-users"></i>Khách Hàng
            </a>
            <a href="@Url.Action("Index", "NhaCC")" class="ajax-link @(ctrl == "NhaCC" ? "active" : "")">
                <i class="fa-solid fa-truck"></i>Nhà Cung Cấp
            </a>
           
            <!-- Giao dịch -->
            <div class="menu-label">Giao dịch</div>
            <a href="@Url.Action("Index", "DonBanHang")" class="ajax-link @(ctrl == "DonBanHang" ? "active" : "")">
                <i class="fa-solid fa-cart-shopping"></i>Đơn Bán Hàng
            </a>
            <a href="@Url.Action("Index", "DonMuaHang")" class="ajax-link @(ctrl == "DonMuaHang" ? "active" : "")">
                <i class="fa-solid fa-basket-shopping"></i>Đơn Mua Hàng
            </a>

            @if (Context.Session.GetString("IsAdmin") == "true")
            {
                <!-- Phân tích -->
                <div class="menu-label">Phân tích</div>
                <a href="@Url.Action("Index", "BaoCao")" class="ajax-link @(ctrl == "BaoCao" ? "active" : "")">
                    <i class="fa-solid fa-chart-line"></i>Báo cáo doanh thu
                </a>

                <div class="menu-label">Hệ thống</div>
                <a href="@Url.Action("Index", "TaiKhoan")" class="ajax-link @(ctrl == "TaiKhoan" ? "active" : "")">
                    <i class="fa-solid fa-user-gear"></i>Quản lý tài khoản
                </a>
            }

            <!-- Địa lý -->
            <div class="menu-label">Địa lý</div>
            <a href="@Url.Action("Index", "Xa")" class="ajax-link @(ctrl == "Xa" || ctrl == "Tinh" ? "active" : "")">
                <i class="fa-solid fa-location-dot"></i>Đơn vị hành chính
            </a>
        }
        else
        {
            <!-- Menu rút gọn cho Khách hàng -->
            <div class="menu-label">Khách hàng</div>
            <a href="@Url.Action("Index", "SanPham")" class="ajax-link @(ctrl == "SanPham" ? "active" : "")">
                <i class="fa-solid fa-box"></i>Xem sản phẩm
            </a>
            <a href="@Url.Action("Index", "DonBanHang")" class="ajax-link @(ctrl == "DonBanHang" ? "active" : "")">
                <i class="fa-solid fa-shopping-cart"></i>Đơn mua hàng
            </a>
        }
    </div>

    <!-- CONTENT -->
    <div class="content">
        <!-- TOP NAVBAR -->
        <header class="top-navbar">
            <div class="d-flex align-items-center">
                <h5 class="m-0 fw-bold" style="color:  #1b5e20">@ViewData["Title"]</h5>
            </div>
            
            <div class="d-flex align-items-center gap-4">
                @{                    
                    string userName = Context.Session.GetString("UserName");
                    string userAvatar = Context.Session.GetString("UserAvatar");
                    string folder = isCustomer ? "customers" : "employees";
                    string avatarPath = string.IsNullOrEmpty(userAvatar)
                        ? Url.Content("~/images/default-user.png")
                        : Url.Content($"~/images/{folder}/{userAvatar}");
                }

                <div class="user-profile d-flex align-items-center gap-3">
                    <div class="text-end d-none d-md-block">
                        <div class="fw-bold lh-1">@userName</div>
                        <small class="text-muted">@(Context.Session.GetString("IsAdmin") == "true" ? "Administrator" : "Staff")</small>
                    </div>
                    <div class="avatar-wrapper shadow-sm rounded-circle p-1 bg-white">
                        <img src="@avatarPath" width="40" height="40" class="rounded-circle" style="object-fit: cover;">
                    </div>
                </div>

                <a class="btn btn-light text-danger border-0" href="javascript:void(0)" onclick="confirmLogout()" title="Đăng xuất">
                    <i class="fa-solid fa-power-off"></i>
                </a>

                <form id="logoutForm" action="@Url.Action("LogoutConfirmed", "Home")" method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </header>

        <main role="main" id="main-content" class="main">
            @RenderBody()
        </main>

        <footer class="border-top text-muted pt-2 text-center">
            <div class="container">
                &copy; 2025 - QuanLyBanHang
            </div>
        </footer>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                showConfirmButton: false,
                timer: 2000,
                showClass: { popup: 'animate__animated animate__bounceIn' },
                hideClass: { popup: 'animate__animated animate__fadeOutUp' },
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        </script>
    }
    else if (TempData["UpdateMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Đã cập nhật!',
                text: '@Html.Raw(TempData["UpdateMessage"])',
                showConfirmButton: false,
                timer: 2000,
                showClass: { popup: 'animate__animated animate__bounceIn' },
                hideClass: { popup: 'animate__animated animate__fadeOutUp' },
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        </script>
    }
    else if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi!',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                showConfirmButton: false,
                timer: 2000,
                showClass: { popup: 'animate__animated animate__bounceIn' },
                hideClass: { popup: 'animate__animated animate__fadeOutUp' }
            });
        </script>
    }

    <script>
        function confirmLogout() {
            Swal.fire({
                title: 'Bạn muốn đăng xuất?',
                text: "Phiên làm việc của bạn sẽ kết thúc!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đăng xuất',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Submit form ẩn để gửi POST request lên Controller
                    document.getElementById('logoutForm').submit();
                }
            })
        }
    </script>
    
</body>
</html>
