@model QuanLyBanHang.Models.Tinh
@{
    ViewBag.Title = "Thông tin tỉnh / thành";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Tinh")" class="text-success text-decoration-none">Tỉnh / Thành Phố</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.MaTinh</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-city text-success fs-1"></i>
                    </div>
                    <h4 class="fw-bold text-dark">@Model.TenTinh</h4>
                    <span class="badged bg-light text-muted border px-3 py-2 rounded-pill small font-monospace">
                        Mã tỉnh: #@Model.MaTinh
                    </span>
                </div>

                <div class="p-4 bg-light rounded-4 mb-4 text-center">
                    <label class="small text-muted text-uppercase fw-bold d-block mb-2">Phân loại đơn vị hành chính</label>
                    <div class="h6 fw-bold text-dark mb-0">Tỉnh / Thành phố trực thuộc trung ương</div>
                </div>

                <hr class="opacity-10 my-4">

                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", "Tinh", new { id = Model.MaTinh })" class="btn btn-success py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa thông tin
                    </a>
                    @if (Context.Session.GetString("IsAdmin") == "true")
                    {
                        <a href="@Url.Action("Delete", "Tinh", new { id = Model.MaTinh })" class="btn btn-outline-danger py-2 fw-bold">
                            <i class="fa-solid fa-trash me-2"></i>Gỡ bỏ tỉnh này
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                        Quay lại danh sách
                    </a>
                </div>
            </div>

            <div class="mt-4 p-3 bg-light-subtle rounded-4 small text-muted text-center shadow-sm">
                <i class="fa-solid fa-triangle-exclamation me-2 text-warning"></i>Cẩn trọng khi gỡ bỏ tỉnh thành vì sẽ gây lỗi cho các Xã/Phường trực thuộc.
            </div>
        </div>
    </div>
</div>
