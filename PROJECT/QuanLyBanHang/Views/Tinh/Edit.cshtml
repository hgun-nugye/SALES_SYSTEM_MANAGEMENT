@model QuanLyBanHang.Models.Tinh
@{
    ViewBag.Title = "Chỉnh sửa tỉnh thành";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Tinh")" class="text-success text-decoration-none">Tỉnh / Thành Phố</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "Tinh", new { id = Model.MaTinh })" class="text-success text-decoration-none">@Model.MaTinh</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-warning-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-hotel text-warning fs-2"></i>
                    </div>
                    <h4 class="fw-bold">Hiệu chỉnh thông tin tỉnh</h4>
                    <p class="text-muted small">Cập nhật tên gọi chính xác theo quy chuẩn hành chính mới.</p>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mã định danh (Read-only)</label>
                        <div class="p-2 px-3 bg-light rounded-3 font-monospace fw-bold text-muted border">
                            <i class="fa-solid fa-lock me-2"></i>#@Model.MaTinh
                            <input type="hidden" asp-for="MaTinh" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên Tỉnh / Thành Phố mới</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-pen-nib text-muted"></i></span>
                            <input asp-for="TenTinh" class="form-control border-0 bg-transparent py-2" />
                        </div>
                        <span asp-validation-for="TenTinh" class="text-danger small mt-1"></span>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-save me-2"></i>Cập nhật thông tin
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaTinh" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
