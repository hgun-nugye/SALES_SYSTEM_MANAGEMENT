@model QuanLyBanHang.Models.Tinh

@{
    ViewBag.Title = "Xác nhận xóa tỉnh thành";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Tinh")" class="text-success text-decoration-none">Tỉnh / Thành Phố</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card border-0 shadow-lg text-center">
                <div class="p-3 bg-danger-subtle rounded-circle d-inline-block mb-3">
                    <i class="fa-solid fa-map-location-dot text-danger fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">Xóa tỉnh thành?</h4>
                <p class="text-muted">Bạn đang thực hiện xóa <strong>@Model.TenTinh</strong>. Hành động này sẽ gỡ bỏ phân cấp địa giới cấp cao nhất của khu vực này.</p>

                <div class="my-4 p-4 bg-light rounded-4 text-start small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Mã tỉnh:</span>
                        <span class="font-monospace fw-bold">#@Model.MaTinh</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Tên tỉnh:</span>
                        <span class="fw-bold fs-6">@Model.TenTinh</span>
                    </div>
                </div>

                <div class="alert alert-warning border-0 small text-start mb-4 text-center">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <strong>Hệ quả:</strong> Tất cả các <strong>Xã/Phường</strong> thuộc tỉnh này sẽ bị mất liên kết hoặc bị xóa theo tùy cấu hình cơ sở dữ liệu.
                </div>

                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaTinh" />
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-danger py-3 fw-bold" onclick="confirmDelete()">
                            <i class="fa-solid fa-trash-can me-2"></i>Xác nhận xóa vĩnh viễn
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaTinh" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ và quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Hủy đăng ký tỉnh thành?',
                text: 'Dữ liệu địa giới này sẽ bị xóa vĩnh viễn khỏi hệ thống.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}
