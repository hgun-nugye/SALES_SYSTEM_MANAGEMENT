@model IEnumerable<QuanLyBanHang.Models.Tinh>

@{
    ViewBag.Title = "Quản lý địa giới - Tỉnh / Thành";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          
        </div>
        
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Xa")" class="btn btn-outline-success shadow-sm">
                <i class="fa-solid fa-location-crosshairs me-2"></i>Danh sách Xã/Phường
            </a>
            <a href="@Url.Action("Create", "Tinh")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-city me-2"></i>Thêm Tỉnh mới
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="md-card mb-4 bg-light border-0">
        <form id="filterForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-bold text-muted text-uppercase">Tìm kiếm Tỉnh / Thành phố</label>
                <div class="input-group bg-white border rounded-3 overflow-hidden">
                    <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass opacity-50"></i></span>
                    <input id="searchBox" name="search" type="text" value="@ViewBag.Search" class="form-control border-0" placeholder="Ví dụ: Hà Nội, TP.HCM, Đà Nẵng...">
                </div>
            </div>
            <div class="col-md-auto ms-auto">
                <button type="button" id="btnReset" class="btn btn-light border px-4">
                    <i class="fa-solid fa-rotate-left me-2"></i>Reset
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4" style="width: 20%">Mã Vùng</th>
                    <th>Tên Tỉnh / Thành Phố</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "Tinh", new { id = item.MaTinh })'">
                            <td class="ps-4">
                                <span class="badged bg-light text-dark font-monospace border">#@item.MaTinh</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.TenTinh</div>
                            </td>
                           
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="py-5 text-center text-muted">
                            <i class="fa-solid fa-earth-asia fs-1 d-block mb-3 opacity-25"></i>
                            Không có dữ liệu tỉnh thành nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const filterForm = document.getElementById('filterForm');
        document.getElementById('searchBox').addEventListener('input', debounce(() => filterForm.submit(), 500));
        document.getElementById('btnReset').addEventListener('click', () => {
            window.location.href = '@Url.Action("Index", "Tinh")';
        });

        function debounce(fn, delay) {
            let timer = null;
            return function() {
                const context = this, args = arguments;
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }
    </script>
}
