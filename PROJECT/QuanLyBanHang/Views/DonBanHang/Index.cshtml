@model IEnumerable<QuanLyBanHang.Models.DonBanHangDetail>

@{
    ViewBag.Title = "Quản lý Đơn bán hàng";
    bool isCustomer = ViewBag.IsCustomer == true;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
      <div></div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create", "DonBanHang")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-cart-plus me-2"></i>Tạo đơn hàng mới
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="md-card mb-4">
        <form id="filterForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-uppercase fw-bold text-muted">Tìm kiếm giao dịch</label>
                <div class="input-group border rounded-3 bg-light">
                    <span class="input-group-text bg-transparent border-0"><i class="fa fa-search text-muted"></i></span>
                    <input type="text" name="search" id="searchBox" class="form-control border-0 bg-transparent" 
                           placeholder="Mã đơn, tên khách hàng..." value="@ViewBag.Search">
                </div>
            </div>
            
            <div class="col-md-2">
                <label class="form-label small text-uppercase fw-bold text-muted">Tháng</label>
                <select name="month" id="monthSelect" class="form-select border-0 bg-light">
                    <option value="">Tất cả</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(ViewBag.Month == i)">Tháng @i</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small text-uppercase fw-bold text-muted">Năm</label>
                <select name="year" id="yearSelect" class="form-select border-0 bg-light">
                    <option value="">Tất cả</option>
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                    {
                        <option value="@y" selected="@(ViewBag.Year == y)">@y</option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="button" id="btnClear" class="btn btn-light flex-grow-1 border">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <button type="submit" class="btn btn-success flex-grow-1 shadow-sm">
                    <i class="fa-solid fa-filter me-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Data -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Mã Đơn Hàng</th>
                    <th>Ngày Lập</th>
                    @if (!isCustomer)
                    {
                        <th>Thông Tin Khách Hàng</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "DonBanHang", new { id = item.MaDBH })'">
                            <td class="ps-4">
                                <div class="font-monospace fw-bold text-dark">@item.MaDBH</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-regular fa-calendar text-muted"></i>
                                    <span>@item.NgayBH.ToString("dd/MM/yyyy")</span>
                                </div>
                            </td>
                            @if (!isCustomer)
                            {
                                <td>
                                    <div class="fw-bold">@item.TenKH</div>
                                    <div class="text-muted small">Mã KH: @item.MaKH</div>
                                </td>
                            }
                           
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-receipt d-block fs-1 mb-3 opacity-25"></i>
                            Không có dữ liệu đơn hàng nào
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-submit filters
            $('#monthSelect, #yearSelect').on('change', function() {
                $('#filterForm').submit();
            });

            // Clear filter
            $('#btnClear').on('click', function() {
                $('#searchBox').val('');
                $('#monthSelect').val('');
                $('#yearSelect').val('');
                $('#filterForm').submit();
            });

            // Debounce search
            let timer;
            $('#searchBox').on('input', function() {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    $('#filterForm').submit();
                }, 500);
            });
        });
    </script>
}