@model QuanLyBanHang.Models.DonBanHang

@{
    ViewBag.Title = "Chỉnh sửa đơn bán hàng";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonBanHang")" class="text-success text-decoration-none">Đơn Bán Hàng</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "DonBanHang", new { id = Model.MaDBH })" class="text-success text-decoration-none">@Model.MaDBH</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>

    <form asp-action="Edit" method="post">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })
        <input type="hidden" asp-for="MaDBH" />

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Thông tin đơn hàng</h5>
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mã đơn hàng</label>
                        <div class="p-2 px-3 bg-light rounded-3 font-monospace fw-bold">#@Model.MaDBH</div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Ngày bán hàng</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-calendar text-muted"></i></span>
                            <input asp-for="NgayBH" type="date" class="form-control border-0 bg-transparent" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Khách hàng</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-user text-muted"></i></span>
                            <select asp-for="MaKH" asp-items="ViewBag.MaKH" class="form-select border-0 bg-transparent"></select>
                        </div>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success shadow-sm">
                            <i class="fa-solid fa-save me-2"></i>Lưu thay đổi
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaDBH" class="btn btn-light border">
                            Hủy bỏ
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Điều chỉnh chi tiết sản phẩm</h5>
                    <div class="table-responsive border rounded-4 overflow-hidden">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th class="text-center" style="width: 25%">Số lượng</th>
                                    <th class="text-end pe-4" style="width: 30%">Đơn giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.CTBHs.Count; i++)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <input type="hidden" asp-for="CTBHs[i].MaSP" />
                                            <div class="fw-bold">@Model.CTBHs[i].TenSP</div>
                                            <div class="small text-muted font-monospace">@Model.CTBHs[i].MaSP</div>
                                        </td>
                                        <td class="text-center">
                                            <input asp-for="CTBHs[i].SLB" class="form-control border-0 bg-light-subtle text-center mx-auto" style="max-width: 100px" />
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="input-group border-0 bg-light-subtle rounded-3">
                                                <input asp-for="CTBHs[i].DGB" class="form-control border-0 bg-transparent text-end" />
                                                <span class="input-group-text border-0 bg-transparent small text-muted">₫</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
