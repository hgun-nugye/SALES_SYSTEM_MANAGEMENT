@model List<QuanLyBanHang.Models.DonBanHangDetail>

@{
    ViewBag.Title = "Xác nhận hủy đơn hàng";
    var header = Model.FirstOrDefault();
    bool isCustomer = ViewBag.IsCustomer == true;
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonBanHang")" class="text-success text-decoration-none">Đơn Bán Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    @if (isCustomer)
    {
        <div class="md-card text-center py-5">
            <i class="fa-solid fa-shield-halved fs-1 text-warning mb-3"></i>
            <h4>Giới hạn quyền hạn</h4>
            <p class="text-muted">Bạn không có quyền tự xóa đơn hàng đã lập. Vui lòng liên hệ quản lý để được hỗ trợ hủy đơn.</p>
            <a asp-action="Index" class="btn btn-success mt-3 shadow-sm px-4">Quay lại danh sách</a>
        </div>
    }
    else if (header != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="md-card border-0 shadow-lg">
                    <div class="text-center mb-4">
                        <div class="p-3 bg-danger-subtle rounded-circle d-inline-block mb-3">
                            <i class="fa-solid fa-file-circle-xmark text-danger fs-1"></i>
                        </div>
                        <h4 class="fw-bold">Xóa đơn bán hàng?</h4>
                        <p class="text-muted">Hành động này sẽ xóa vĩnh viễn hóa đơn #@header.MaDBH và các chi tiết liên quan.</p>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6 font-monospace">
                            <label class="small text-muted text-uppercase fw-bold d-block mb-1">Mã đơn hàng</label>
                            <div class="fw-bold">@header.MaDBH</div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <label class="small text-muted text-uppercase fw-bold d-block mb-1">Ngày lập</label>
                            <div class="fw-bold">@header.NgayBH.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-12">
                            <label class="small text-muted text-uppercase fw-bold d-block mb-1">Khách hàng</label>
                            <div class="fw-bold">@header.TenKH (@header.MaKH)</div>
                        </div>
                    </div>

                    <div class="table-responsive border rounded-4 overflow-hidden mb-4">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end pe-4">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">@item.TenSP</td>
                                        <td class="text-center">@item.SLB</td>
                                        <td class="text-end pe-4">@(((item.SLB ?? 0) * (item.DGB ?? 0)).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light-subtle fw-bold">
                                <tr>
                                    <td colspan="2" class="ps-4">Tổng giá trị đơn:</td>
                                    <td class="text-end pe-4 text-danger">@Model.Sum(x => (x.SLB ?? 0) * (x.DGB ?? 0)).ToString("N0") ₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <form id="deleteForm" asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@header.MaDBH" />
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-danger py-3 fw-bold" onclick="confirmDelete()">
                                <i class="fa-solid fa-trash-can me-2"></i>Xác nhận xóa đơn hàng này
                            </button>
                            <a asp-action="Details" asp-route-id="@header.MaDBH" class="btn btn-light py-2 border fw-bold text-muted">
                                Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Xóa đơn hàng?',
                text: 'Dữ liệu doanh thu liên quan sẽ bị loại bỏ khỏi báo cáo.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa vĩnh viễn',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}
