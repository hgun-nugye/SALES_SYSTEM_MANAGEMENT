@model QuanLyBanHang.Models.DonBanHang

@{
    var spList = ViewBag.MaSP as IEnumerable<SelectListItem>;
    bool isCustomer = ViewBag.IsCustomer == true;
    ViewBag.Title = isCustomer ? "Tiến hành mua hàng" : "Lập đơn bán hàng mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonBanHang")" class="text-success text-decoration-none">Đơn Bán Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tạo mới</li>
        </ol>
    </nav>

    <form asp-action="Create" method="post">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

        <div class="row g-4">
            <!-- Left: Transaction Info -->
            <div class="col-lg-4">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Thông tin giao dịch</h5>
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Ngày lập đơn</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-calendar text-muted"></i></span>
                            <input asp-for="NgayBH" class="form-control border-0 bg-transparent" type="date" readonly />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Khách hàng</label>
                        @if (!isCustomer)
                        {
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-user-tag text-muted"></i></span>
                                <select asp-for="MaKH" asp-items="ViewBag.MaKH" class="form-select border-0 bg-transparent">
                                    <option value="">Chọn khách hàng</option>
                                </select>
                            </div>
                            @Html.ValidationMessageFor(m => m.MaKH, "", new { @class = "text-danger small mt-1" })
                        }
                        else
                        {
                            <input type="hidden" asp-for="MaKH" />
                            <div class="p-3 bg-success-subtle text-success rounded-3 fw-bold">
                                <i class="fa-solid fa-user-circle me-2"></i>@Context.Session.GetString("UserName")
                            </div>
                        }
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success shadow-sm py-2 fw-bold">
                            <i class="fa-solid fa-check-double me-2"></i>Xác nhận đơn hàng
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2">
                            Hủy bỏ
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right: Line Items -->
            <div class="col-lg-8">
                <div class="md-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Danh sách sản phẩm</h5>
                        <button type="button" id="addRow" class="btn btn-sm btn-outline-success">
                            <i class="fa-solid fa-plus me-1"></i>Thêm dòng
                        </button>
                    </div>

                    <!-- Hidden Template -->
                    <select id="spTemplate" class="d-none">
                        @foreach (var sp in spList)
                        {
                            <option value="@sp.Value">@sp.Text</option>
                        }
                    </select>

                    <div class="table-responsive border rounded-4 overflow-hidden mb-3">
                        <table class="table table-hover align-middle mb-0" id="ctbhTable">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4" style="width: 45%">Sản phẩm</th>
                                    <th class="text-center" style="width: 20%">Số lượng</th>
                                    <th class="text-end" style="width: 25%">Đơn giá</th>
                                    <th class="text-center" style="width: 10%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CTBHs != null && Model.CTBHs.Count > 0)
                                {
                                    for (int i = 0; i < Model.CTBHs.Count; i++)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <select name="CTBHs[@i].MaSP" class="form-select border-0 bg-light-subtle select-sp">
                                                    <option value="">Chọn sản phẩm</option>
                                                    @foreach (var sp in spList)
                                                    {
                                                        <option value="@sp.Value" selected="@(sp.Value == Model.CTBHs[i].MaSP)">@sp.Text</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input name="CTBHs[@i].SLB" type="number" min="1" class="form-control border-0 bg-light-subtle text-center" value="@Model.CTBHs[i].SLB" /></td>
                                            <td><input name="CTBHs[@i].DGB" type="number" class="form-control border-0 bg-light-subtle text-end" value="@Model.CTBHs[i].DGB" @(isCustomer ? "readonly" : "") /></td>
                                            <td class="text-center pe-3"><button type="button" class="btn btn-link text-danger removeRow p-0"><i class="fa-solid fa-circle-minus fs-5"></i></button></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <select name="CTBHs[0].MaSP" class="form-select border-0 bg-light-subtle select-sp">
                                                <option value="">Chọn sản phẩm</option>
                                                @foreach (var sp in spList)
                                                {
                                                    <option value="@sp.Value">@sp.Text</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input name="CTBHs[0].SLB" type="number" min="1" class="form-control border-0 bg-light-subtle text-center" value="1" /></td>
                                        <td><input name="CTBHs[0].DGB" type="number" class="form-control border-0 bg-light-subtle text-end" value="0" @(isCustomer ? "readonly" : "") /></td>
                                        <td class="text-center pe-3"><button type="button" class="btn btn-link text-danger removeRow p-0"><i class="fa-solid fa-circle-minus fs-5"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="p-3 bg-light rounded-4 text-center">
                        <small class="text-muted"><i class="fa-solid fa-lightbulb me-2"></i>Hệ thống sẽ tự cập nhật đơn giá khi bạn chọn sản phẩm.</small>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const addRowBtn = document.getElementById("addRow");
            const tableBody = document.querySelector("#ctbhTable tbody");
            const isCustomer = @(isCustomer.ToString().ToLower());

            async function updatePrice(selectElement) {
                const maSP = selectElement.value;
                const row = selectElement.closest("tr");
                const priceInput = row.querySelector('input[name*=".DGB"]');
                if (!maSP) { priceInput.value = 0; return; }
                try {
                    const response = await fetch(`/SanPham/GetGia?id=${maSP}`);
                    const data = await response.json();
                    priceInput.value = data.gia;
                } catch (error) { console.error("Error fetching price:", error); }
            }

            tableBody.addEventListener("change", function (e) {
                if (e.target.classList.contains("select-sp")) { updatePrice(e.target); }
            });

            addRowBtn.addEventListener("click", () => {
                let index = tableBody.rows.length;
                const spOptionsHtml = document.getElementById("spTemplate").innerHTML;
                const newRow = document.createElement("tr");
                newRow.innerHTML = `
                    <td class="ps-4">
                        <select name="CTBHs[${index}].MaSP" class="form-select border-0 bg-light-subtle select-sp">
                            <option value="">Chọn sản phẩm</option>
                            ${spOptionsHtml}
                        </select>
                    </td>
                    <td><input name="CTBHs[${index}].SLB" type="number" min="1" class="form-control border-0 bg-light-subtle text-center" value="1" /></td>
                    <td><input name="CTBHs[${index}].DGB" type="number" class="form-control border-0 bg-light-subtle text-end" value="0" ${isCustomer ? "readonly" : ""} /></td>
                    <td class="text-center pe-3"><button type="button" class="btn btn-link text-danger removeRow p-0"><i class="fa-solid fa-circle-minus fs-5"></i></button></td>
                `;
                tableBody.appendChild(newRow);
            });

            tableBody.addEventListener("click", function (e) {
                if (e.target.closest(".removeRow")) {
                    if (tableBody.rows.length > 1) { e.target.closest("tr").remove(); }
                    else { alert("Đơn hàng phải có ít nhất một sản phẩm."); }
                }
            });
        });
    </script>
}
