@model QuanLyBanHang.Models.LoaiSPDto

@{
    ViewBag.Title = "Xác nhận xóa loại sản phẩm";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "LoaiSP")" class="text-success text-decoration-none">Loại Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="md-card border-0 shadow-lg text-center">
                <div class="p-3 bg-danger-subtle rounded-circle d-inline-block mb-3">
                    <i class="fa-solid fa-folder-minus text-danger fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">Gỡ bỏ loại sản phẩm?</h4>
                <p class="text-muted">Bạn đang thực hiện xóa mục <strong>@Model.TenLoai</strong> khỏi hệ thống danh mục.</p>

                <div class="my-4 p-4 bg-light rounded-4 text-start small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Mã phân loại:</span>
                        <span class="font-monospace fw-bold">#@Model.MaLoai</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Tên loại:</span>
                        <span class="fw-bold">@Model.TenLoai</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Nhóm sản phẩm:</span>
                        <span class="fw-bold text-success">@Model.TenNhom</span>
                    </div>
                </div>

                <div class="alert alert-warning border-0 small text-start mb-4">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <strong>Lưu ý:</strong> Hành động này có thể thất bại nếu có sản phẩm nào thuộc loại này đang tồn tại trong hệ thống.
                </div>

                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaLoai" />
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-danger py-3 fw-bold" onclick="confirmDelete()">
                            <i class="fa-solid fa-trash-can me-2"></i>Xác nhận xóa bỏ
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaLoai" class="btn btn-light py-2 border fw-bold text-muted">
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Xóa danh mục này?',
                text: 'Hành động này sẽ xóa vĩnh viễn dữ liệu phân loại khỏi hệ thống.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}
