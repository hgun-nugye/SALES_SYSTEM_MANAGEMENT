@model IEnumerable<QuanLyBanHang.Models.LoaiSPDto>

@{
    ViewBag.Title = "Phân loại sản phẩm";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          
        </div>
        
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "NhomSP")" class="btn btn-outline-success shadow-sm">
                <i class="fa-solid fa-layer-group me-2"></i>Quản lý Nhóm SP
            </a>
            <a href="@Url.Action("Create", "LoaiSP")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-folder-plus me-2"></i>Thêm loại mới
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="md-card mb-4 bg-light border-0">
        <form id="filterForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted text-uppercase">Tìm kiếm theo tên</label>
                <div class="input-group bg-white border rounded-3 overflow-hidden">
                    <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass opacity-50"></i></span>
                    <input id="searchBox" type="text" name="search" value="@ViewBag.Search" class="form-control border-0" placeholder="Ví dụ: Đồ uống, Thực phẩm đông lạnh...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted text-uppercase">Lọc theo nhóm</label>
                @Html.DropDownList("group", (SelectList)ViewBag.MaNhom, "Tất cả các nhóm", new { @class = "form-select border rounded-3", id = "groupSelect" })
            </div>
            <div class="col-md-auto ms-auto">
                <button type="button" id="btnReset" class="btn btn-light border px-4">
                    <i class="fa-solid fa-rotate-left me-2"></i>Làm mới
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4" style="width: 15%">Mã Loại</th>
                    <th>Tên Loại Sản Phẩm</th>
                    <th>Nhóm Sản phẩm</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "LoaiSP", new { id = item.MaLoai })'">
                            <td class="ps-4">
                                <span class="badged bg-light text-success font-monospace border">#@item.MaLoai</span>
                            </td>
                            <td class="fw-bold text-dark">@item.TenLoai</td>
                            <td>
                                <div class="badged bg-info-subtle text-info border border-info-subtle rounded-pill px-3">
                                    <i class="fa-solid fa-tags me-2"></i>@item.TenNhom
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-5 text-center text-muted">
                            <i class="fa-solid fa-folder-open fs-1 d-block mb-3 opacity-25"></i>
                            Không có dữ liệu loại sản phẩm phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const filterForm = document.getElementById('filterForm');
        document.getElementById('searchBox').addEventListener('input', debounce(() => filterForm.submit(), 500));
        document.getElementById('groupSelect').addEventListener('change', () => filterForm.submit());
        document.getElementById('btnReset').addEventListener('click', () => {
            window.location.href = '@Url.Action("Index", "LoaiSP")';
        });

        function debounce(fn, delay) {
            let timer = null;
            return function() {
                const context = this, args = arguments;
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }
    </script>
}
