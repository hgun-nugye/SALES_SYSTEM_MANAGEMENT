@model QuanLyBanHang.Models.LoaiSP
@{
    ViewBag.Title = "Thêm loại sản phẩm mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "LoaiSP")" class="text-success text-decoration-none">Loại Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-folder-plus text-success fs-2"></i>
                    </div>
                    <h4 class="fw-bold">Khai báo loại hàng hóa</h4>
                    <p class="text-muted small">Thông tin loại sản phẩm giúp phân nhóm hàng hóa hiệu quả trong kho và kinh doanh.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mã định danh (ID)</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                            <input asp-for="MaLoai" class="form-control border-0 bg-transparent py-2" placeholder="Ví dụ: L001, DOUONG..." />
                        </div>
                        <span asp-validation-for="MaLoai" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên loại sản phẩm</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-tag text-muted"></i></span>
                            <input asp-for="TenLoai" class="form-control border-0 bg-transparent py-2" placeholder="Nhập tên loại sản phẩm..." />
                        </div>
                        <span asp-validation-for="TenLoai" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Thuộc nhóm danh mục</label>
                        <div class="input-group border rounded-3 bg-light overflow-hidden">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-layer-group text-muted"></i></span>
                            <select asp-for="MaNhom" asp-items="ViewBag.MaNhom" class="form-select border-0 bg-transparent py-2">
                                <option value="">-- Chọn nhóm sản phẩm --</option>
                            </select>
                        </div>
                        <span asp-validation-for="MaNhom" class="text-danger small mt-1"></span>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-save me-2"></i>Lưu thông tin loại sản phẩm
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
