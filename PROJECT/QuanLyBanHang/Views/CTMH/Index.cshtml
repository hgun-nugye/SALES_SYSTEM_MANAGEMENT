@model IEnumerable<QuanLyBanHang.Models.CTMHDetailDto>

@{
    ViewBag.Title = "Chi tiết nhập hàng";
    var maDMH = ViewBag.MaDMH;
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonMuaHang")" class="text-success text-decoration-none">Đơn Mua Hàng</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "DonMuaHang", new { id = maDMH })" class="text-success text-decoration-none">@maDMH</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hạng mục nhập</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-success mb-1">Cấu trúc đơn nhập hàng</h4>
            <p class="text-muted small mb-0">Hạng mục sản phẩm thuộc đơn #@maDMH</p>
        </div>
        <a asp-action="Create" asp-route-maDMH="@maDMH" class="btn btn-success shadow-sm">
            <i class="fa-solid fa-cart-plus me-1"></i>Bổ sung mặt hàng
        </a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Sản Phẩm Nhập</th>
                    <th class="text-center">Số Lượng</th>
                    <th class="text-end">Đơn Giá Nhập</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.TenSP</div>
                                <div class="small text-muted font-monospace">SKU: @item.MaSP</div>
                            </td>
                            <td class="text-center">
                                <span class="badged bg-light text-success border px-3">@item.SLM</span>
                            </td>
                            <td class="text-end font-monospace fw-bold">@item.DGM.ToString("N0") <small>₫</small></td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-maDMH="@item.MaDMH" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-light text-warning" title="Sửa">
                                        <i class="fa-solid fa-pen-nib"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-maDMH="@item.MaDMH" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-light text-danger" title="Xóa">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-5 text-center text-muted">
                            <i class="fa-solid fa-clipboard-list fs-1 d-block mb-3 opacity-25"></i>
                            Chưa có thông tin sản phẩm nhập cho đơn này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a href="@Url.Action("Details", "DonMuaHang", new { id = maDMH })" class="btn btn-light border py-2 px-4 shadow-sm text-muted">
            <i class="fa-solid fa-arrow-left me-2"></i>Quay lại đơn mua
        </a>
    </div>
</div>
