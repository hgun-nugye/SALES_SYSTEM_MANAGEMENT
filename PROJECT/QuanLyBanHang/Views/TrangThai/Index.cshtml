@model IEnumerable<QuanLyBanHang.Models.TrangThai>

@{
    ViewBag.Title = "Quản lý trạng thái hệ thống";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
           
        </div>
        
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "SanPham")" class="btn btn-outline-success shadow-sm">
                <i class="fa-solid fa-box me-2"></i>Quản lý Sản phẩm
            </a>
            <a href="@Url.Action("Create", "TrangThai")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-plus-circle me-2"></i>Thêm trạng thái
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="md-card mb-4 bg-light border-0">
        <form id="filterForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-bold text-muted text-uppercase">Tìm kiếm trạng thái</label>
                <div class="input-group bg-white border rounded-3 overflow-hidden">
                    <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass opacity-50"></i></span>
                    <input id="searchBox" name="search" type="text" value="@ViewBag.Search" class="form-control border-0" placeholder="Ví dụ: Hoàn tất, Đang xử lý, Đã hủy...">
                </div>
            </div>
            <div class="col-md-auto ms-auto">
                <button type="button" id="btnReset" class="btn btn-light border px-4">
                    <i class="fa-solid fa-rotate-left me-2"></i>Reset lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0 text-center">
            <thead>
                <tr>
                    <th class="ps-4" style="width: 25%">Mã Số</th>
                    <th class="text-start">Tên Trạng Thái Hiển Thị</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "TrangThai", new { id = item.MaTT })'">
                            <td class="ps-4">
                                <span class="badged bg-light text-success border px-2 py-1 font-monospace">@item.MaTT</span>
                            </td>
                            <td class="text-start">
                                <div class="fw-bold text-dark">@item.TenTT</div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="py-5 text-center text-muted">
                            <i class="fa-solid fa-list-check fs-1 d-block mb-3 opacity-25"></i>
                            Không có tiêu chuẩn trạng thái nào được tìm thấy.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const filterForm = document.getElementById('filterForm');
        document.getElementById('searchBox').addEventListener('input', debounce(() => filterForm.submit(), 500));
        document.getElementById('btnReset').addEventListener('click', () => {
            window.location.href = '@Url.Action("Index", "TrangThai")';
        });

        function debounce(fn, delay) {
            let timer = null;
            return function() {
                const context = this, args = arguments;
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }
    </script>
}
