@model QuanLyBanHang.Models.TrangThai
@{
    ViewBag.Title = "Thêm trạng thái mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "TrangThai")" class="text-success text-decoration-none">Trạng Thái</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-plus-circle text-success fs-2"></i>
                    </div>
                    <h4 class="fw-bold">Khai báo trạng thái</h4>
                    <p class="text-muted small">Thêm mới trạng thái dùng chung cho các quy trình nghiệp vụ của phần mềm.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm mb-4">
                            <ul class="mb-0 small">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên trạng thái hiển thị</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-tag text-muted"></i></span>
                            <input asp-for="TenTT" class="form-control border-0 bg-transparent py-2" placeholder="Ví dụ: Đang lấy hàng, Giao thành công..." />
                        </div>
                        <span asp-validation-for="TenTT" class="text-danger small mt-1"></span>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-save me-2"></i>Lưu trạng thái mới
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
