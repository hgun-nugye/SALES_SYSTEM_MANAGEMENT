@model QuanLyBanHang.Models.TrangThai
@{
    ViewBag.Title = "Thông tin chi tiết trạng thái";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "TrangThai")" class="text-success text-decoration-none">Trạng Thái</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.MaTT</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-list-check text-success fs-1"></i>
                    </div>
                    <h4 class="fw-bold text-dark">@Model.TenTT</h4>
                    <span class="badged bg-light text-muted border px-3 py-2 rounded-pill small font-monospace">
                        ID: #@Model.MaTT
                    </span>
                </div>

                <div class="p-4 bg-light rounded-4 mb-4 text-center">
                    <label class="small text-muted text-uppercase fw-bold d-block mb-2">Đặc tính tham số</label>
                    <div class="fw-bold text-success fs-5">
                        <i class="fa-solid fa-check-double me-2"></i>Trạng thái hợp lệ
                    </div>
                </div>

                <hr class="opacity-10 my-4">

                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", "TrangThai", new { id = Model.MaTT })" class="btn btn-success py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Cập nhật tên hiển thị
                    </a>
                    @if (Context.Session.GetString("IsAdmin") == "true")
                    {
                        <a href="@Url.Action("Delete", "TrangThai", new { id = Model.MaTT })" class="btn btn-outline-danger py-2 fw-bold">
                            <i class="fa-solid fa-trash me-2"></i>Gỡ bỏ trạng thái
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                        Quay lại danh sách
                    </a>
                </div>
            </div>

            <div class="mt-4 text-center small text-muted">
                <p>Mã trạng thái ảnh hưởng đến luồng xử lý nghiệp vụ của hệ thống.</p>
            </div>
        </div>
    </div>
</div>
