@model QuanLyBanHang.Models.Xa
@{
    ViewBag.Title = "Thêm xã / phường mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Xa")" class="text-success text-decoration-none">Xã / Phường</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-map-pin text-success fs-2"></i>
                    </div>
                    <h4 class="fw-bold">Khai báo địa danh</h4>
                    <p class="text-muted small">Bổ sung đơn vị hành chính cấp xã/phường vào hệ thống quản lý địa giới.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên Xã / Phường / Thị Trấn</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-location-dot text-muted"></i></span>
                            <input asp-for="TenXa" class="form-control border-0 bg-transparent py-2" placeholder="Nhập tên địa danh..." />
                        </div>
                        <span asp-validation-for="TenXa" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Thuộc Tỉnh / Thành Phố</label>
                        <div class="input-group border rounded-3 bg-light overflow-hidden">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-city text-muted"></i></span>
                            <select asp-for="MaTinh" asp-items="ViewBag.MaTinhList" class="form-select border-0 bg-transparent py-2">
                                <option value="">-- Chọn tỉnh chủ quản --</option>
                            </select>
                        </div>
                        <span asp-validation-for="MaTinh" class="text-danger small mt-1"></span>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-save me-2"></i>Lưu địa danh mới
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
