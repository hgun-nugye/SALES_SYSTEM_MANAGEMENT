@model IEnumerable<QuanLyBanHang.Models.XaDTO>

@{
    ViewBag.Title = "Quản lý địa giới - Xã/Phường";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          
        </div>
        
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Tinh")" class="btn btn-outline-success shadow-sm">
                <i class="fa-solid fa-map-location-dot me-2"></i>Quản lý Tỉnh/TP
            </a>
            <a href="@Url.Action("Create", "Xa")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-location-dot me-2"></i>Thêm Xã mới
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="md-card mb-4 bg-light border-0">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted text-uppercase">Tìm kiếm địa bàn</label>
                <div class="input-group bg-white border rounded-3 overflow-hidden">
                    <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass opacity-50"></i></span>
                    <input id="searchBox" type="text" class="form-control border-0" placeholder="Nhập tên Xã, Tỉnh hoặc Mã vùng...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted text-uppercase">Lọc theo Tỉnh/Thành</label>
                <select id="maTinhSelect" asp-items="ViewBag.TinhList" class="form-select border rounded-3">
                    <option value="">Tất cả các tỉnh</option>
                </select>
            </div>
            <div class="col-md-auto ms-auto">
                <button type="button" id="btnClear" class="btn btn-light border px-4">
                    <i class="fa-solid fa-rotate-left me-2"></i>Reset lọc
                </button>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4" style="width: 15%">Mã Xã</th>
                    <th>Tên Xã / Phường</th>
                    <th>Thuộc Tỉnh / Thành Phố</th>
                </tr>
            </thead>
            <tbody id="xaTableBody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" 
                            onclick="window.location='@Url.Action("Details", "Xa", new { id = item.MaXa })'"
                            data-tenxa="@item.TenXa"
                            data-maxa="@item.MaXa"
                            data-matinh="@item.MaTinh"
                            data-tentinh="@item.TenTinh">
                            <td class="ps-4">
                                <span class="badged bg-light text-dark font-monospace border">#@item.MaXa</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenXa</div>
                            </td>
                            <td>
                                <div class="badged bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                    <i class="fa-solid fa-city me-2 small"></i>@item.TenTinh
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            const search = document.getElementById("searchBox").value.toLowerCase().trim();
            const tinh = document.getElementById("maTinhSelect").value;

            document.querySelectorAll("#xaTableBody tr").forEach(row => {
                const tenXa = row.dataset.tenxa.toLowerCase();
                const maXa = row.dataset.maxa.toLowerCase();
                const maTinh = row.dataset.matinh;
                const tenTinh = row.dataset.tentinh.toLowerCase();

                const matchSearch = tenXa.includes(search) || maXa.includes(search) || tenTinh.includes(search);
                const matchTinh = tinh === "" || maTinh === tinh;

                row.style.display = (matchSearch && matchTinh) ? "" : "none";
            });
        }

        document.getElementById("searchBox").addEventListener("input", filterTable);
        document.getElementById("maTinhSelect").addEventListener("change", filterTable);
        document.getElementById("btnClear").addEventListener("click", () => {
            document.getElementById("searchBox").value = "";
            document.getElementById("maTinhSelect").value = "";
            filterTable();
        });
    </script>
}
