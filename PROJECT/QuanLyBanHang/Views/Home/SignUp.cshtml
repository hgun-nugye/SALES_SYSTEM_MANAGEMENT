@model QuanLyBanHang.Models.KhachHang
@{
    ViewData["Title"] = "Đăng ký thành viên mới";
}

<style>
    .signup-card-container {
        max-width: 900px;
        margin: 40px auto;
    }

    .form-header-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: var(--md-primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    .registration-step-title {
        font-weight: 800;
        color: var(--md-text-main);
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        font-size: 1.25rem;
    }

    .registration-step-title::after {
        content: '';
        flex-grow: 1;
        height: 1px;
        background: rgba(0,0,0,0.05);
    }

    .image-preview-box {
        width: 150px;
        height: 150px;
        border-radius: 20px;
        background: #f5f5f5;
        border: 2px dashed #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto 16px;
        position: relative;
    }

    .image-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .image-preview-box i {
        font-size: 2.5rem;
        color: #bdbdbd;
    }

    .form-floating-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-floating-group label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--md-text-muted);
        margin-bottom: 8px;
        display: block;
    }

    .required-star {
        color: #d32f2f;
    }
</style>

<div class="signup-card-container animate__animated animate__fadeIn">
    <div class="text-center mb-5">
        <h2 class="fw-800 text-dark mb-1">Trở thành thành viên Canteen</h2>
        <p class="text-muted">Gia nhập cộng đồng để nhận nhiều ưu đãi và dịch vụ tốt nhất</p>
    </div>

    <form asp-action="SignUp" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        
        <div class="row">
            <div class="col-lg-8">
                <div class="md-card p-4 p-md-5">
                    <div class="registration-step-title">
                        <span class="badged bg-success rounded-circle p-2 px-3 me-2">1</span>
                        Thông tin cá nhân
                    </div>

                    <div class="row">
                        <div class="col-md-12 form-floating-group">
                            <label>Họ và tên khách hàng <span class="required-star">*</span></label>
                            <input asp-for="TenKH" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                            <span asp-validation-for="TenKH" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6 form-floating-group">
                            <label>Số điện thoại liên hệ <span class="required-star">*</span></label>
                            <input asp-for="DienThoaiKH" class="form-control" placeholder="0xxxxxxxxx" required />
                            <span asp-validation-for="DienThoaiKH" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-floating-group">
                            <label>Địa chỉ Email</label>
                            <input asp-for="EmailKH" type="email" class="form-control" placeholder="email@example.com" />
                            <span asp-validation-for="EmailKH" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-floating-group">
                            <label>Giới tính</label>
                            <select asp-for="GioiTinh" class="form-select">
                                <option value="">Chọn giới tính</option>
                                <option value="true">Nam</option>
                                <option value="false">Nữ</option>
                            </select>
                        </div>
                    </div>

                    <div class="registration-step-title mt-4">
                        <span class="badged bg-success rounded-circle p-2 px-3 me-2">2</span>
                        Địa chỉ giao hàng
                    </div>

                    <div class="row">
                        <div class="col-md-12 form-floating-group">
                            <label>Địa chỉ cụ thể (Số nhà, đường...) <span class="required-star">*</span></label>
                            <input asp-for="DiaChiKH" class="form-control" placeholder="Nhập địa chỉ của bạn" required />
                            <span asp-validation-for="DiaChiKH" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-floating-group">
                            <label>Tỉnh / Thành phố <span class="required-star">*</span></label>
                            <select id="MaTinh" name="maTinh" asp-items="@ViewBag.Tinh" class="form-select" required>
                                <option value="">-- Chọn Tỉnh --</option>
                            </select>
                        </div>

                        <div class="col-md-6 form-floating-group">
                            <label>Quận / Huyện / Xã <span class="required-star">*</span></label>
                            <select id="MaXa" asp-for="MaXa" asp-items="@ViewBag.Xa" class="form-select" required>
                                <option value="">-- Chọn đơn vị --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="md-card p-4 text-center">
                    <div class="registration-step-title justify-content-center border-0 mb-4">
                        Ảnh đại diện
                    </div>
                    
                    <div class="image-preview-box" id="imagePreviewArea">
                        <img id="imagePreview" class="d-none" alt="Preview" />
                        <i class="fa-solid fa-cloud-arrow-up" id="uploadPlaceholder"></i>
                    </div>
                    
                    <div class="mb-4">
                        <label for="AnhFile" class="btn btn-light border w-100 py-2">
                            <i class="fa-solid fa-image me-2"></i>Chọn ảnh tải lên
                        </label>
                        <input type="file" asp-for="AnhFile" id="AnhFile" class="d-none" accept="image/*" onchange="previewImage(this)" />
                    </div>

                    <hr class="opacity-10">

                    <button type="submit" class="btn btn-success w-100 py-3 fw-bold shadow-sm mt-3">
                        <i class="fa-solid fa-user-plus me-2"></i>Hoàn tất đăng ký
                    </button>
                    
                    <p class="small text-muted mt-3">Bằng cách đăng ký, bạn đồng ý với Điều khoản và Chính sách bảo mật của chúng tôi.</p>
                </div>
                
                <div class="mt-4 text-center">
                    <p class="text-muted small">Đã có tài khoản? <a href="@Url.Action("Login", "Home")" class="text-success fw-bold text-decoration-none">Đăng nhập</a></p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('uploadPlaceholder');
            const file = input.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                };
                reader.readAsDataURL(file);
            }
        }

        $(function () {
            $('#MaTinh').change(function () {
                var maTinh = $(this).val();
                $('#MaXa').html('<option value="">-- Đang tải... --</option>');

                if (maTinh) {
                    $.getJSON('/KhachHang/GetXaByTinh', { maTinh: maTinh }, function (data) {
                        var options = '<option value="">-- Chọn đơn vị --</option>';
                        $.each(data, function (i, xa) {
                            var maXa = xa.MaXa !== undefined ? xa.MaXa : xa.maXa;
                            var tenXa = xa.TenXa !== undefined ? xa.TenXa : xa.tenXa;
                            options += `<option value="${maXa}">${tenXa}</option>`;
                        });
                        $('#MaXa').html(options);
                    });
                } else {
                    $('#MaXa').html('<option value="">-- Chọn đơn vị --</option>');
                }
            });
        });
    </script>
}
