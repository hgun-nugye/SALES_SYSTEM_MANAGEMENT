@model List<QuanLyBanHang.Models.SanPhamDto>
@{
    ViewData["Title"] = "Trang chủ - Hệ Thống Quản Lý Canteen";
}

<style>
    .hero-banner {
        height: 400px;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1542838132-92c53300491e?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
        background-size: cover;
        background-position: center;
        border-radius: 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        text-align: center;
        margin-bottom: 40px;
        box-shadow: var(--md-shadow-lg);
    }

    .hero-banner h1 {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 1rem;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .hero-banner p {
        font-size: 1.25rem;
        max-width: 600px;
        opacity: 0.9;
    }

    .product-grid-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid rgba(0,0,0,0.05);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .product-grid-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    }

    .product-img-placeholder {
        height: 200px;
        background: #f1f8e9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--md-primary);
        font-size: 4rem;
    }

    .product-details {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-cat {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--md-primary);
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .product-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .product-price {
        font-size: 1.4rem;
        font-weight: 800;
        color: #2e7d32;
        margin-bottom: 20px;
    }

    .btn-action {
        margin-top: auto;
        border-radius: 12px;
        padding: 12px;
        font-weight: 700;
        transition: all 0.3s;
    }

    .featured-badged {
        position: absolute;
        top: 15px;
        right: 15px;
        background: var(--md-accent);
        color: #000;
        padding: 4px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.7rem;
        z-index: 10;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
</style>

<div class="container p-0">
    <div class="hero-banner animate__animated animate__fadeIn">
        <h1>Canteen K8 Online</h1>
        <p>Hệ thống cung ứng nhu yếu phẩm và quản lý hàng hóa hiện đại, phục vụ nhanh chóng và tiện lợi.</p>
        <div class="mt-4">
            <a href="@Url.Action("Login", "Home")" class="btn btn-light btn-lg px-5 py-3 fw-bold rounded-pill text-success shadow">
                <i class="fa-solid fa-sign-in-alt me-1"></i>Đăng nhập
            </a>           
        </div>
    </div>

    <div id="san-pham" class="pt-4">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">Sản Phẩm Đang Kinh Doanh</h3>
                <p class="text-muted">Lựa chọn từ danh mục hàng hóa đa dạng của chúng tôi</p>
            </div>
            <div class="d-none d-md-block">
                <span class="badged bg-success-subtle text-success border border-success-subtle px-3 py-2">
                    <i class="fa-solid fa-check-circle me-1"></i>Đảm bảo chất lượng
                </span>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model)
                {
                    <div class="col-sm-6 col-lg-4 col-xl-3">
                        <div class="product-grid-card position-relative">
                            <span class="featured-badged text-uppercase">Bán chạy</span>
                            <div class="product-img-placeholder">
                                <i class="fa-solid fa-box-open"></i>
                            </div>
                            <div class="product-details">
                                <span class="product-cat">Thực phẩm & Đồ uống</span>
                                <h5 class="product-name">@product.TenSP</h5>
                                <div class="product-price">
                                    @if (product.GiaBan.HasValue)
                                    {
                                        <span>@product.GiaBan.Value.ToString("N0") <small>₫</small></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">Liên hệ báo giá</span>
                                    }
                                </div>
                                
                                <div class="d-grid">
                                    @if (Context.Session.GetString("IsLoggedIn") == "true")
                                    {
                                        <a href="@Url.Action("Details", "SanPham", new { id = product.MaSP })" class="btn btn-success btn-action">
                                            <i class="fa-solid fa-eye me-2"></i>Xem Chi Tiết
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Login", "Home")" class="btn btn-light border btn-action">
                                            <i class="fa-solid fa-lock me-2"></i>Đăng nhập để xem
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="md-card text-center py-5">
                <i class="fa-solid fa-store-slash fs-1 text-muted mb-3 opacity-25"></i>
                <h4 class="text-muted">Kho hàng tạm hết</h4>
                <p class="text-muted small">Chúng tôi đang cập nhật thêm sản phẩm mới. Vui lòng quay lại sau.</p>
            </div>
        }
    </div>
</div>
