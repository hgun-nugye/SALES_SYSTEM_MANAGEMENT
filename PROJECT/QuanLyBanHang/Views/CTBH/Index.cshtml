@model IEnumerable<QuanLyBanHang.Models.CTBHDetailDto>

@{
    ViewBag.Title = "Chi tiết hạng mục bán hàng";
    var maDBH = ViewBag.MaDBH;
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonBanHang")" class="text-success text-decoration-none">Đơn Bán Hàng</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "DonBanHang", new { id = maDBH })" class="text-success text-decoration-none">@maDBH</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết Hạng mục</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-success mb-1">Thành phần đơn hàng</h4>
            <p class="text-muted small mb-0">Quản lý các sản phẩm trong đơn hàng #@maDBH</p>
        </div>
        <a asp-action="Create" asp-route-maDBH="@maDBH" class="btn btn-success shadow-sm">
            <i class="fa-solid fa-plus-circle me-1"></i>Thêm sản phẩm mới
        </a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Sản Phẩm</th>
                    <th class="text-center">Số Lượng</th>
                    <th class="text-end">Đơn Giá</th>
                    <th class="text-end">Thành Tiền</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.TenSP</div>
                                <div class="small text-muted">Mã SP: @item.MaSP</div>
                            </td>
                            <td class="text-center">
                                <span class="badged bg-light text-dark border">@item.SLB</span>
                            </td>
                            <td class="text-end font-monospace">@item.DGB.ToString("N0") <small>₫</small></td>
                            <td class="text-end fw-bold text-success font-monospace">@((item.SLB * item.DGB).ToString("N0")) <small>₫</small></td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-maDBH="@item.MaDBH" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-light text-warning" title="Sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-maDBH="@item.MaDBH" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-light text-danger" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-5 text-center text-muted">
                            <i class="fa-solid fa-box-open fs-1 d-block mb-3 opacity-25"></i>
                            Đơn hàng hiện đang trống hạng mục.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a href="@Url.Action("Details", "DonBanHang", new { id = maDBH })" class="btn btn-light border py-2 px-4 shadow-sm">
            <i class="fa-solid fa-arrow-left me-2"></i>Về chi tiết đơn hàng
        </a>
    </div>
</div>
