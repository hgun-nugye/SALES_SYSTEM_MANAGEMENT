@model QuanLyBanHang.Models.NhomSP

@{
    ViewBag.Title = "Xác nhận xóa nhóm sản phẩm";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "NhomSP")" class="text-success text-decoration-none">Nhóm Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card border-0 shadow-lg text-center">
                <div class="p-3 bg-danger-subtle rounded-circle d-inline-block mb-3">
                    <i class="fa-solid fa-layer-minus text-danger fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">Gỡ bỏ nhóm sản phẩm?</h4>
                <p class="text-muted">Bạn đang thực hiện xóa nhóm <strong>@Model.TenNhom</strong>. Việc này sẽ gỡ bỏ phân cấp danh mục cao nhất.</p>

                <div class="my-4 p-4 bg-light rounded-4 text-start small">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Mã nhóm:</span>
                        <span class="font-monospace fw-bold">#@Model.MaNhom</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Tên nhóm:</span>
                        <span class="fw-bold">@Model.TenNhom</span>
                    </div>
                </div>

                <div class="alert alert-warning border-0 small text-start mb-4 text-center">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Chỉ có thể xóa nếu không có bất kỳ <strong>Loại Sản Phẩm</strong> nào thuộc nhóm này.
                </div>

                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaNhom" />
                    
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-danger py-3 fw-bold" onclick="confirmDelete()">
                            <i class="fa-solid fa-trash-can me-2"></i>Xác nhận gỡ bỏ
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaNhom" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ và quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Xóa nhóm vĩnh viễn?',
                text: 'Dữ liệu phân cấp này sẽ không thể khôi phục.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}
