@model QuanLyBanHang.Models.NhomSP

@{
    ViewBag.Title = "Thêm nhóm hàng hóa mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "NhomSP")" class="text-success text-decoration-none">Nhóm Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tạo nhóm mới</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-shapes text-success fs-2"></i>
                    </div>
                    <h4 class="fw-bold">Tổ chức nhóm hàng</h4>
                    <p class="text-muted small">Cấp danh mục cao nhất để quản lý các dòng sản phẩm chính.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mã định danh nhóm</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                            <input asp-for="MaNhom" class="form-control border-0 bg-transparent py-2" placeholder="Ví dụ: DT, TT, GD..." />
                        </div>
                        <span asp-validation-for="MaNhom" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên nhóm sản phẩm</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-layer-group text-muted"></i></span>
                            <input asp-for="TenNhom" class="form-control border-0 bg-transparent py-2" placeholder="Nhập tên chính của dòng hàng..." />
                        </div>
                        <span asp-validation-for="TenNhom" class="text-danger small mt-1"></span>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-plus-circle me-2"></i>Khai báo nhóm mới
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
