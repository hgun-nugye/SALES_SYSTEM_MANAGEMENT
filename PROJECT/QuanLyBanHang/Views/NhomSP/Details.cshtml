@model QuanLyBanHang.Models.NhomSP

@{
    ViewBag.Title = "Thông tin nhóm sản phẩm";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "NhomSP")" class="text-success text-decoration-none">Nhóm Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.MaNhom</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-layer-group text-success fs-1"></i>
                    </div>
                    <h4 class="fw-bold text-dark">@Model.TenNhom</h4>
                    <span class="badged bg-light text-muted border px-3 py-2 rounded-pill small font-monospace">
                        ID: #@Model.MaNhom
                    </span>
                </div>

                <div class="p-4 bg-light rounded-4 mb-4">
                    <label class="small text-muted text-uppercase fw-bold d-block mb-2">Tên định danh cấp cao</label>
                    <div class="h5 fw-bold text-dark mb-0">@Model.TenNhom</div>
                </div>

                <hr class="opacity-10 my-4">

                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", "NhomSP", new { id = Model.MaNhom })" class="btn btn-success py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Sửa tên nhóm
                    </a>
                    @if (Context.Session.GetString("IsAdmin") == "true")
                    {
                        <a href="@Url.Action("Delete", "NhomSP", new { id = Model.MaNhom })" class="btn btn-outline-danger py-2 fw-bold">
                            <i class="fa-solid fa-trash me-2"></i>Gỡ bỏ nhóm
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                        Quay lại danh sách
                    </a>
                </div>
            </div>

            <div class="mt-4 p-3 bg-light-subtle rounded-4 small text-muted border border-white">
                <i class="fa-solid fa-circle-info me-2 text-success"></i>Các loại sản phẩm thuộc nhóm này sẽ được liệt kê trong mục quản lý loại sản phẩm.
            </div>
        </div>
    </div>
</div>