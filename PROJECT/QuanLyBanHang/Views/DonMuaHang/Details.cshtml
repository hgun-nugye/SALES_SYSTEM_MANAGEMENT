@model List<QuanLyBanHang.Models.DonMuaHangDetail>

@{
    ViewBag.Title = "Chi tiết đơn nhập hàng";
    var don = Model.FirstOrDefault();
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonMuaHang")" class="text-success text-decoration-none">Đơn Mua Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">@don?.MaDMH</li>
        </ol>
    </nav>

    @if (don != null)
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-12">
                <div class="md-card bg-success text-white border-0 shadow-sm">
                    <div class="row align-items-center p-2">
                        <div class="col-md-8">
                            <h6 class="text-uppercase opacity-75 mb-1 small fw-bold">Chứng từ nhập kho</h6>
                            <h3 class="fw-bold mb-0">Đơn hàng #@don.MaDMH</h3>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <div class="h4 mb-0 fw-bold">@Model.Sum(x => (x.SLM ?? 0) * (x.DGM ?? 0)).ToString("N0") ₫</div>
                            <small class="opacity-75">Tổng giá trị nhập</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left: Supplier & Time -->
            <div class="col-lg-4">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Thông tin cung ứng</h5>
                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold d-block mb-1">Đối tác cung cấp</label>
                        <div class="h6 fw-bold text-dark mb-0">
                            <i class="fa-solid fa-truck-field me-2 text-success"></i>@don.TenNCC
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold d-block mb-1">Thời gian nhập kho</label>
                        <div class="h6 fw-bold text-dark mb-0">
                            <i class="fa-solid fa-calendar-check me-2 text-success"></i>@don.NgayMH.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Edit", "DonMuaHang", new { id = don.MaDMH })" class="btn btn-success">
                            <i class="fa-solid fa-file-pen me-2"></i>Chỉnh sửa chứng từ
                        </a>
                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <a href="@Url.Action("Delete", "DonMuaHang", new { id = don.MaDMH })" class="btn btn-outline-danger">
                                <i class="fa-solid fa-trash me-2"></i>Xóa đơn nhập
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-light border mt-2">
                            <i class="fa-solid fa-arrow-left me-2"></i>Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right: Line Items -->
            <div class="col-lg-8">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Danh mục hàng hóa nhập</h5>
                    <div class="table-responsive border rounded-4 overflow-hidden">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end">Đơn Giá Nhập</th>
                                    <th class="text-end pe-4">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@item.TenSP</div>
                                            <div class="small text-muted font-monospace">@item.MaSP</div>
                                        </td>
                                        <td class="text-center fw-bold">@item.SLM</td>
                                        <td class="text-end text-muted">@item.DGM?.ToString("N0") ₫</td>
                                        <td class="text-end pe-4 fw-bold">@(((item.SLM ?? 0) * (item.DGM ?? 0)).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light-subtle fw-bold">
                                <tr>
                                    <td colspan="3" class="ps-4">Tổng cộng:</td>
                                    <td class="text-end pe-4 text-success h5 mb-0 fw-bold">@Model.Sum(x => (x.SLM ?? 0) * (x.DGM ?? 0)).ToString("N0") ₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="md-card text-center py-5">
            <i class="fa-solid fa-circle-exclamation fs-1 text-warning mb-3"></i>
            <h4>Dữ liệu không tồn tại</h4>
            <p class="text-muted">Đơn mua hàng có thể đã bị xóa hoặc không còn tồn tại trên hệ thống.</p>
            <a asp-action="Index" class="btn btn-success px-4 mt-3">Quay lại danh sách</a>
        </div>
    }
</div>
