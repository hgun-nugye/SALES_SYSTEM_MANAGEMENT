@model List<QuanLyBanHang.Models.DonMuaHangDetail>

@{
    ViewBag.Title = "Hủy chứng từ nhập hàng";
    var header = Model.FirstOrDefault();
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonMuaHang")" class="text-success text-decoration-none">Đơn Mua Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận hủy</li>
        </ol>
    </nav>

    @if (header != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="md-card border-0 shadow-lg">
                    <div class="text-center mb-4">
                        <div class="p-3 bg-danger-subtle rounded-circle d-inline-block mb-3">
                            <i class="fa-solid fa-boxes-packing text-danger fs-1"></i>
                        </div>
                        <h4 class="fw-bold">Hủy chứng từ nhập #@header.MaDMH?</h4>
                        <p class="text-muted">Lưu ý: Hành động này sẽ trừ đi số lượng tồn kho tương ứng của các sản phẩm trong đơn.</p>
                    </div>

                    <div class="row g-4 mb-4 bg-light p-3 rounded-4 mx-0">
                        <div class="col-md-6">
                            <label class="small text-muted text-uppercase fw-bold d-block mb-1">Nhà cung cấp</label>
                            <div class="fw-bold">@header.TenNCC</div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <label class="small text-muted text-uppercase fw-bold d-block mb-1">Ngày chứng từ</label>
                            <div class="fw-bold">@header.NgayMH.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>

                    <div class="table-responsive border rounded-4 overflow-hidden mb-4">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th class="text-center">Số Lượng</th>
                                    <th class="text-end pe-4">Giá Trị Nhập</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">@item.TenSP</td>
                                        <td class="text-center">@item.SLM</td>
                                        <td class="text-end pe-4">@(((item.SLM ?? 0) * (item.DGM ?? 0)).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light-subtle fw-bold">
                                <tr>
                                    <td colspan="2" class="ps-4 text-muted">Tổng cộng hoàn kho:</td>
                                    <td class="text-end pe-4 text-danger h5 mb-0">@Model.Sum(x => (x.SLM ?? 0) * (x.DGM ?? 0)).ToString("N0") ₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <form id="deleteForm" asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@header.MaDMH" />
                        
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-danger py-3 fw-bold" onclick="confirmDelete()">
                                <i class="fa-solid fa-trash-can me-2"></i>Xác nhận hủy và cập nhật kho
                            </button>
                            <a asp-action="Details" asp-route-id="@header.MaDMH" class="btn btn-light py-2 border fw-bold text-muted">
                                Quanh lại chi tiết
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete() {
            Swal.fire({
                title: 'Hủy đơn nhập hàng?',
                text: 'Số lượng tồn kho sẽ bị trừ đi tương ứng. Hành động không thể hoàn tác.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý hủy đơn',
                cancelButtonText: 'Quay lại',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm').submit();
                }
            });
        }
    </script>
}