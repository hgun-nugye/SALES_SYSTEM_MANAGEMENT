@model IEnumerable<QuanLyBanHang.Models.DonMuaHangDetail>

@{
    ViewBag.Title = "Quản lý nhập hàng";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
         
        </div>
        
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create", "DonMuaHang")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-cart-flatbed me-2"></i>Lập đơn mua hàng mới
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="md-card mb-4 bg-light border-0">
        <form id="filterForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted text-uppercase">Tìm kiếm đơn hàng</label>
                <div class="input-group bg-white border rounded-3 overflow-hidden">
                    <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass opacity-50"></i></span>
                    <input id="searchBox" type="text" name="search" value="@ViewBag.Search" class="form-control border-0" placeholder="Mã đơn, Tên nhà cung cấp...">
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted text-uppercase">Tháng</label>
                <select name="month" id="monthSelect" class="form-select border rounded-3">
                    <option value="">Tất cả</option>
                    @for (int i = 1; i <= 12; i++) {
                        <option value="@i" selected="@(ViewBag.Month == i)">Tháng @i</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted text-uppercase">Năm</label>
                <select name="year" id="yearSelect" class="form-select border rounded-3">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--) {
                        <option value="@y" selected="@(ViewBag.Year == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-auto ms-auto">
                <button type="button" id="btnReset" class="btn btn-light border px-4">
                    <i class="fa-solid fa-rotate-left me-2"></i>Xóa lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Mã Đơn Nhập</th>
                    <th class="text-center">Ngày Nhập Kho</th>
                    <th>Nhà Cung Cấp</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "DonMuaHang", new { id = item.MaDMH })'">
                            <td class="ps-4">
                                <span class="badged bg-light text-dark font-monospace border">#@item.MaDMH</span>
                            </td>
                            <td class="text-center fw-bold">
                                @item.NgayMH.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenNCC</div>
                                <div class="small text-muted font-monospace">ID Đối tác: @item.MaNCC</div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-5 text-center text-muted">
                            <i class="fa-solid fa-boxes-packing fs-1 d-block mb-3 opacity-25"></i>
                            Không ghi nhận dữ liệu nhập hàng trong thời gian này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const filterForm = document.getElementById('filterForm');
        document.getElementById('searchBox').addEventListener('input', debounce(() => filterForm.submit(), 500));
        document.getElementById('monthSelect').addEventListener('change', () => filterForm.submit());
        document.getElementById('yearSelect').addEventListener('change', () => filterForm.submit());
        document.getElementById('btnReset').addEventListener('click', () => {
            window.location.href = '@Url.Action("Index", "DonMuaHang")';
        });

        function debounce(fn, delay) {
            let timer = null;
            return function() {
                const context = this, args = arguments;
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }
    </script>
}