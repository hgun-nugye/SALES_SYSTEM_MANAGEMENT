@model QuanLyBanHang.Models.DonMuaHangEditCTMH

@{
    ViewBag.Title = "Chỉnh sửa đơn nhập hàng";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonMuaHang")" class="text-success text-decoration-none">Đơn Mua Hàng</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "DonMuaHang", new { id = Model.MaDMH })" class="text-success text-decoration-none">@Model.MaDMH</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>

    <form asp-action="Edit" method="post">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })
        <input type="hidden" asp-for="MaDMH" />

        <div class="row g-4">
            <!-- Left: Transaction Info -->
            <div class="col-lg-4">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Chứng từ nhập kho</h5>
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mã chứng từ</label>
                        <div class="p-2 px-3 bg-light rounded-3 font-monospace fw-bold">#@Model.MaDMH</div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Ngày nhập hàng</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-calendar text-muted"></i></span>
                            <input asp-for="NgayMH" type="date" class="form-control border-0 bg-transparent" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Nhà cung cấp</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-truck text-muted"></i></span>
                            <select asp-for="MaNCC" asp-items="ViewBag.MaNCC" class="form-select border-0 bg-transparent"></select>
                        </div>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success shadow-sm py-2">
                            <i class="fa-solid fa-save me-2"></i>Lưu thay đổi
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaDMH" class="btn btn-light border py-2">Hủy bỏ</a>
                    </div>
                </div>
            </div>

            <!-- Right: Item List -->
            <div class="col-lg-8">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Chi tiết hàng hóa nhập</h5>
                    <div class="table-responsive border rounded-4 overflow-hidden">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th class="text-center" style="width: 120px">Số Lượng</th>
                                    <th class="text-end pe-4" style="width: 200px">Giá Nhập</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.ChiTiet.Count; i++)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <input type="hidden" asp-for="ChiTiet[i].MaDMH" />
                                            <input type="hidden" asp-for="ChiTiet[i].MaSP" />
                                            <input type="hidden" asp-for="ChiTiet[i].TenSP" />
                                            <div class="fw-bold">@Model.ChiTiet[i].TenSP</div>
                                            <div class="small text-muted font-monospace">@Model.ChiTiet[i].MaSP</div>
                                        </td>
                                        <td>
                                            <input type="number" asp-for="ChiTiet[i].SLM" class="form-control border-0 bg-light-subtle text-center" />
                                        </td>
                                        <td class="pe-4">
                                            <div class="input-group border-0 bg-light-subtle rounded">
                                                <input type="number" asp-for="ChiTiet[i].DGM" class="form-control border-0 bg-transparent text-end" />
                                                <span class="input-group-text border-0 bg-transparent small text-muted">₫</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
