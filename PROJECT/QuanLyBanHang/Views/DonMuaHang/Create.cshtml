@model QuanLyBanHang.Models.DonMuaHang

@{
    ViewBag.Title = "Lập đơn nhập hàng";
    var details = Model?.CTMHs ?? new List<QuanLyBanHang.Models.CTMH>();
    if (details.Count == 0) { details.Add(new QuanLyBanHang.Models.CTMH()); }

    var spOptions = "";
    var spList = ViewBag.MaSP as IEnumerable<SelectListItem>;
    if (spList != null) {
        foreach (var sp in spList) {
            spOptions += $"<option value='{sp.Value}'>{sp.Text}</option>";
        }
    }
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "DonMuaHang")" class="text-success text-decoration-none">Đơn Mua Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lập đơn nhập</li>
        </ol>
    </nav>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

        <div class="row g-4">
            <!-- Left: Transaction Info -->
            <div class="col-lg-4">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Thông tin nhập kho</h5>
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Ngày nhập hàng</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-calendar text-muted"></i></span>
                            <input asp-for="NgayMH" class="form-control border-0 bg-transparent" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Nhà cung cấp đối tác</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-truck text-muted"></i></span>
                            <select asp-for="MaNCC" asp-items="ViewBag.MaNCC" class="form-select border-0 bg-transparent">
                                <option value="">Chọn nhà cung cấp</option>
                            </select>
                        </div>
                        <span asp-validation-for="MaNCC" class="text-danger small mt-1"></span>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold">
                            <i class="fa-solid fa-file-export me-2"></i>Hoàn tất nhập hàng
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2">Hủy bỏ</a>
                    </div>
                </div>
            </div>

            <!-- Right: Product List -->
            <div class="col-lg-8">
                <div class="md-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Danh sách sản phẩm nhập</h5>
                        <button type="button" id="addRow" class="btn btn-sm btn-outline-success">
                            <i class="fa-solid fa-plus me-1"></i>Thêm dòng
                        </button>
                    </div>

                    <div class="table-responsive border rounded-4 overflow-hidden">
                        <table class="table align-middle mb-0" id="ctmhTable">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th class="text-center" style="width: 120px">Số Lượng</th>
                                    <th class="text-end" style="width: 200px">Đơn Giá Nhập</th>
                                    <th class="text-center" style="width: 60px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < details.Count; i++)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <select name="CTMHs[@i].MaSP" class="form-select border-0 bg-light-subtle">
                                                <option value="">Chọn sản phẩm...</option>
                                                @foreach (var sp in ViewBag.MaSP as IEnumerable<SelectListItem>) {
                                                    <option value="@sp.Value" selected="@(details[i].MaSP == sp.Value)">@sp.Text</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input name="CTMHs[@i].SLM" class="form-control border-0 bg-light-subtle text-center" type="number" min="1" value="@(details[i].SLM ?? 0)" />
                                        </td>
                                        <td>
                                            <div class="input-group border-0 bg-light-subtle rounded">
                                                <input name="CTMHs[@i].DGM" class="form-control border-0 bg-transparent text-end" type="number" min="0" value="@(details[i].DGM ?? 0)" />
                                                <span class="input-group-text border-0 bg-transparent small text-muted">₫</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link text-danger p-0 removeRow">
                                                <i class="fa-solid fa-circle-xmark"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 p-3 bg-light rounded-4 small text-muted">
                        <i class="fa-solid fa-circle-info me-2 text-success"></i>Đơn giá nhập sẽ được sử dụng để tính giá vốn và cập nhật tồn kho sau khi lưu.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const addRowBtn = document.getElementById("addRow");
            const tableBody = document.querySelector("#ctmhTable tbody");
            let index = tableBody.rows.length;
            const spOptionsHtml = `@Html.Raw(spOptions)`;

            addRowBtn.addEventListener("click", () => {
                const newRow = document.createElement("tr");
                newRow.innerHTML = `
                    <td class="ps-4">
                        <select name="CTMHs[${index}].MaSP" class="form-select border-0 bg-light-subtle">
                            <option value="">Chọn sản phẩm...</option>
                            ${spOptionsHtml}
                        </select>
                    </td>
                    <td><input type="number" name="CTMHs[${index}].SLM" min="1" class="form-control border-0 bg-light-subtle text-center" value="1" /></td>
                    <td>
                        <div class="input-group border-0 bg-light-subtle rounded">
                            <input type="number" name="CTMHs[${index}].DGM" min="0" class="form-control border-0 bg-transparent text-end" value="0" />
                            <span class="input-group-text border-0 bg-transparent small text-muted">₫</span>
                        </div>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-link text-danger p-0 removeRow"><i class="fa-solid fa-circle-xmark"></i></button>
                    </td>
                `;
                tableBody.appendChild(newRow);
                index++;
            });

            tableBody.addEventListener("click", function (e) {
                if (e.target.closest(".removeRow")) {
                    const row = e.target.closest("tr");
                    if (tableBody.rows.length > 1) {
                        row.remove();
                        // Re-index
                        Array.from(tableBody.rows).forEach((r, i) => {
                            r.querySelectorAll("input, select").forEach(el => {
                                el.name = el.name.replace(/\[\d+\]/, `[${i}]`);
                            });
                        });
                        index = tableBody.rows.length;
                    }
                }
            });
        });
    </script>
}
