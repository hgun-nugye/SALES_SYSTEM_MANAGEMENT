@model QuanLyBanHang.Models.TaiKhoan

@{
    ViewBag.Title = "Cập nhật tài khoản hệ thống";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "TaiKhoan")" class="text-success text-decoration-none">Tài Khoản</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Details", "TaiKhoan", new { id = Model.MaTK })" class="text-success text-decoration-none">@Model.TenDN</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cập nhật</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-warning-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-user-gear text-warning fs-2"></i>
                    </div>
                    <h4 class="fw-bold">Chỉnh sửa tài khoản</h4>
                    <p class="text-muted small">Cập nhật thông tin định danh và phân quyền người dùng.</p>
                </div>

                <form asp-action="Edit">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })
                    <input type="hidden" asp-for="MaTK" />

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mã tài khoản (ID)</label>
                        <div class="p-2 px-3 bg-light rounded-3 font-monospace fw-bold text-muted">#@Model.MaTK</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên đăng nhập mới</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-at text-muted"></i></span>
                            <input asp-for="TenDN" class="form-control border-0 bg-transparent py-2" />
                        </div>
                        <span asp-validation-for="TenDN" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mật khẩu mới (Nếu có)</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input asp-for="MatKhau" type="password" class="form-control border-0 bg-transparent py-2" placeholder="Để trống nếu giữ nguyên" />
                        </div>
                        <small class="text-muted d-block mt-1">Chỉ nhập nếu bạn muốn thay đổi mật khẩu hiện tại.</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Vai trò hệ thống</label>
                        <div class="input-group border rounded-3 bg-light overflow-hidden">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-user-shield text-muted"></i></span>
                            <select asp-for="VaiTro" class="form-select border-0 bg-transparent py-2">
                                <option value="false" selected="@(Model.VaiTro == false)">Nhân viên</option>
                                <option value="true" selected="@(Model.VaiTro == true)">Quản trị viên (Admin)</option>
                            </select>
                        </div>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-save me-2"></i>Lưu các thay đổi
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaTK" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
