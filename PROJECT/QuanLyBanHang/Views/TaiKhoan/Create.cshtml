@model QuanLyBanHang.Models.TaiKhoan

@{
    ViewBag.Title = "Cấp tài khoản mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "TaiKhoan")" class="text-success text-decoration-none">Tài Khoản</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tạo mới</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="md-card">
                <div class="text-center mb-4">
                    <div class="p-3 bg-success-subtle rounded-circle d-inline-block mb-3">
                        <i class="fa-solid fa-user-plus text-success fs-2"></i>
                    </div>
                    <h4 class="fw-bold">Cấp mới tài khoản</h4>
                    <p class="text-muted small">Thông tin này dùng để đăng nhập vào hệ thống quản trị.</p>
                </div>

                <form asp-action="Create">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên đăng nhập (Username)</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-id-badged text-muted"></i></span>
                            <input asp-for="TenDN" class="form-control border-0 bg-transparent py-2" placeholder="Ví dụ: nhanvien01" />
                        </div>
                        <span asp-validation-for="TenDN" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Mật khẩu khởi tạo</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <input asp-for="MatKhau" type="password" class="form-control border-0 bg-transparent py-2" placeholder="********" />
                        </div>
                        <span asp-validation-for="MatKhau" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Phân quyền người dùng</label>
                        <div class="input-group border rounded-3 bg-light overflow-hidden">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-users-gear text-muted"></i></span>
                            <select asp-for="VaiTro" class="form-select border-0 bg-transparent py-2">
                                <option value="false">Nhân viên (Quyền hạn cơ bản)</option>
                                <option value="true">Quản trị viên (Toàn quyền)</option>
                            </select>
                        </div>
                        <span asp-validation-for="VaiTro" class="text-danger small mt-1"></span>
                    </div>

                    <hr class="opacity-10 my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-circle-check me-2"></i>Tạo tài khoản hệ thống
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2 text-muted fw-bold">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>

            <div class="mt-4 p-3 bg-light-subtle rounded-4 small border border-dashed text-muted">
                <i class="fa-solid fa-shield-halved me-2 text-success"></i>Hệ thống sẽ tự động mã hóa mật khẩu bằng thuật toán SHA256 trước khi lưu trữ vào cơ sở dữ liệu.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
