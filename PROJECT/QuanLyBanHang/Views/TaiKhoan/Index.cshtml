@model IEnumerable<QuanLyBanHang.Models.TaiKhoan>

@{
    ViewBag.Title = "Quản lý Tài khoản";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
           
        </div>
        
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-user-shield me-2"></i>Tạo tài khoản mới
            </a>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">ID Tài Khoản</th>
                    <th>Tên Tài Khoản</th>
                    <th class="text-center">Mật Khẩu</th>
                    <th class="text-center">Vai Trò</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "TaiKhoan", new { id = item.MaTK })'">
                        <td class="ps-4">
                            <span class="badged bg-light text-dark font-monospace border">@item.MaTK</span>
                        </td>
                        <td class="fw-bold text-dark">
                            <i class="fa-solid fa-user-circle me-2 opacity-50"></i>@item.TenDN
                        </td>
                        <td class="text-center">
                            <span class="text-muted small">••••••••</span>
                        </td>
                        <td class="text-center">
                            @if (item.VaiTro)
                            {
                                <span class="badged bg-success-subtle text-success border border-success-subtle">
                                    <i class="fa-solid fa-crown me-1"></i>Quản lý
                                </span>
                            }
                            else
                            {
                                <span class="badged bg-info-subtle text-success border border-info-subtle">
                                    <i class="fa-solid fa-user-tag me-1 text-info"></i>Nhân viên
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
