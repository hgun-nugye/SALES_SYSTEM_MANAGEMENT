@model QuanLyBanHang.Models.NhaCC
@{
    ViewBag.Title = "Thêm nhà cung cấp mới";
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "NhaCC")" class="text-success text-decoration-none">Nhà Cung Cấp</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>

    <form asp-action="Create" method="post">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm mb-4" })

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="md-card">
                    <h5 class="fw-bold mb-4">Thông tin đối tác</h5>
                    
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Tên doanh nghiệp / Nhà cung cấp</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-building text-muted"></i></span>
                            <input asp-for="TenNCC" class="form-control border-0 bg-transparent" placeholder="Ví dụ: Công ty TNHH Thực phẩm sạch" />
                        </div>
                        <span asp-validation-for="TenNCC" class="text-danger small mt-1"></span>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Số điện thoại liên hệ</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input asp-for="DienThoaiNCC" class="form-control border-0 bg-transparent" placeholder="024xxxxxxx" />
                            </div>
                            <span asp-validation-for="DienThoaiNCC" class="text-danger small mt-1"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Hòm thư điện tử (Email)</label>
                            <div class="input-group border rounded-3 bg-light">
                                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                                <input asp-for="EmailNCC" type="email" class="form-control border-0 bg-transparent" placeholder="contact@supplier.com" />
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-4 mt-5">Địa chỉ trụ sở</h5>
                    <div class="mb-4">
                        <label class="form-label small text-uppercase fw-bold text-muted">Số nhà, đường, khu công nghiệp</label>
                        <div class="input-group border rounded-3 bg-light">
                            <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-map-location-dot text-muted"></i></span>
                            <input asp-for="DiaChiNCC" class="form-control border-0 bg-transparent" placeholder="Lô CN1, Khu công nghiệp ABC..." />
                        </div>
                        <span asp-validation-for="DiaChiNCC" class="text-danger small mt-1"></span>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Tỉnh / Thành phố</label>
                            <select id="MaTinh" name="maTinh" asp-items="@ViewBag.Tinh" class="form-select border rounded-3 bg-light p-3">
                                <option value="">Chọn Tỉnh/Thành</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Xã / Phường / Thị trấn</label>
                            <select id="MaXa" asp-for="MaXa" asp-items="@ViewBag.Xa" class="form-select border rounded-3 bg-light p-3">
                                <option value="">Chọn Xã/Phường</option>
                            </select>
                            <span asp-validation-for="MaXa" class="text-danger small mt-1"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="md-card bg-light border-0 mb-4">
                    <h5 class="fw-bold mb-4">Xác nhận hợp tác</h5>
                    <p class="text-muted small mb-4">Thông tin nhà cung cấp phục vụ trực tiếp cho việc lập đơn mua hàng và quản lý công nợ.</p>
                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-success py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-circle-check me-2"></i>Lưu thông tin đối tác
                        </button>
                        <a asp-action="Index" class="btn btn-light border py-2">Hủy bỏ</a>
                    </div>
                </div>

                <div class="md-card">
                    <h6 class="fw-bold text-muted text-uppercase mb-3 small">Mẹo nhỏ</h6>
                    <p class="small text-muted mb-0">Việc nhập đầy đủ Email giúp hệ thống tự động gửi yêu cầu báo giá trong tương lai.</p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#MaTinh').change(function () {
                var maTinh = $(this).val();
                if (maTinh) {
                    $('#MaXa').html('<option value="">Đang tải...</option>');
                    $.getJSON('/KhachHang/GetXaByTinh', { maTinh: maTinh }, function (data) {
                        var options = '<option value="">Chọn Xã/Phường</option>';
                        $.each(data, function (i, xa) {
                            options += `<option value="${xa.maXa}">${xa.tenXa}</option>`;
                        });
                        $('#MaXa').html(options);
                    });
                }
            });
        });
    </script>
}
