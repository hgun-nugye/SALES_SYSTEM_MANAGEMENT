@model IEnumerable<QuanLyBanHang.Models.NhaCCDetailView>

@{
    ViewBag.Title = "Đối tác & Nhà cung cấp";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
          
        </div>
        
        <div class="d-flex gap-2">
            <a href="@Url.Action("Create", "NhaCC")" class="btn btn-success shadow-sm">
                <i class="fa-solid fa-truck-field me-2"></i>Thêm đối tác mới
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="md-card mb-4 bg-light border-0">
        <form id="filterForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted text-uppercase">Tìm kiếm đối tác</label>
                <div class="input-group bg-white border rounded-3 overflow-hidden">
                    <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-magnifying-glass opacity-50"></i></span>
                    <input id="searchBox" type="text" name="search" value="@ViewBag.Search" class="form-control border-0" placeholder="Tên, Email hoặc Số điện thoại...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted text-uppercase">Khu vực (Tỉnh)</label>
                <select id="tinhSelect" name="tinh" asp-items="ViewBag.TinhList" class="form-select border rounded-3">
                    <option value="">Tất cả khu vực</option>
                </select>
            </div>
            <div class="col-md-auto ms-auto">
                <button type="button" id="btnReset" class="btn btn-light border px-4">
                    <i class="fa-solid fa-rotate-left me-2"></i>Làm mới
                </button>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Mã NCC</th>
                    <th>Tên Nhà Cung Cấp</th>
                    <th>Liên Hệ</th>
                    <th>Địa Chỉ Trụ Sở</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="cursor: pointer" onclick="window.location='@Url.Action("Details", "NhaCC", new { id = item.MaNCC })'">
                            <td class="ps-4">
                                <span class="badged bg-light text-dark font-monospace border">@item.MaNCC</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenNCC</div>
                                <div class="small text-muted font-monospace">@item.EmailNCC</div>
                            </td>
                            <td>
                                <div class="h6 mb-0">@item.DienThoaiNCC</div>
                            </td>
                            <td>
                                <div class="small text-dark">@item.DiaChiNCC</div>
                                <div class="small text-muted">@item.TenXa, @item.TenTinh</div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-5 text-center text-muted">
                            <i class="fa-solid fa-inbox fs-1 d-block mb-3 opacity-25"></i>
                            Không tìm thấy nhà cung cấp phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function debounce(fn, delay) {
            let timer = null;
            return function() {
                const context = this, args = arguments;
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }

        const filterForm = document.getElementById('filterForm');
        document.getElementById('searchBox').addEventListener('input', debounce(() => filterForm.submit(), 500));
        document.getElementById('tinhSelect').addEventListener('change', () => filterForm.submit());
        document.getElementById('btnReset').addEventListener('click', () => {
            window.location.href = '@Url.Action("Index", "NhaCC")';
        });
    </script>
}
